<Window x:Class="AstraCat.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:local="clr-namespace:AstraCat"
        Title="AstraCaptioner · 小猫做字幕"
        Icon="avares://AstraCat/Assets/Brand/AstraCat.ico"
        Width="1020" Height="680" MinWidth="920" MinHeight="580"
        Background="#F7F7F8"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#3399F3" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF6FD" />
    <SolidColorBrush x:Key="TextBrush" Color="#20212A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#858894" />
    <SolidColorBrush x:Key="LineBrush" Color="#EAEBF0" />
    <LinearGradientBrush x:Key="TranslationProviderActiveBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#FFFFFF" Offset="0" />
      <GradientStop Color="#F2F6FF" Offset="1" />
    </LinearGradientBrush>
    <!-- Geometry resources used by navigation and model-management controls. -->
