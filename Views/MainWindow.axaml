      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#374151" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.actionPrimarySmall">
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#3399F3" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.actionPrimarySmall:pointerover">
      <Setter Property="Background" Value="#228BE6" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.actionPrimarySmall:pressed">
      <Setter Property="Background" Value="#1B7FD9" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.actionPrimarySmall TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.actionPrimarySmall icons|MaterialIcon">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.actionPrimarySmall /template/ ContentPresenter">
      <Setter Property="Background" Value="#3399F3" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
      <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.actionPrimarySmall:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#228BE6" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
      <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.actionPrimarySmall:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1B7FD9" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
      <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.actionOutlineSmall">
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#374151" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="Button.actionOutlineSmall:pointerover">
      <Setter Property="Background" Value="#F3F4F6" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>

    <Style Selector="Button.actionDangerSmall">
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#EF4444" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.actionDangerSmall:pointerover">
      <Setter Property="Background" Value="#DC2626" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.actionDangerSmall:pressed">
      <Setter Property="Background" Value="#B91C1C" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.actionDangerSmall TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.actionDangerSmall icons|MaterialIcon">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.actionDangerSmall /template/ ContentPresenter">
      <Setter Property="Background" Value="#EF4444" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
      <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.actionDangerSmall:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#DC2626" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
      <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.actionDangerSmall:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#B91C1C" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
      <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.actionLink">
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#4B5563" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="Button.actionLink:pointerover">
      <Setter Property="Background" Value="#ECEEF1" />
      <Setter Property="Foreground" Value="#111827" />
    </Style>
  </Window.Styles>

  <!-- 系统装饰窗口：标题栏、边框、阴影、最小化/最大化/关闭均由 Windows 提供。
       WindowChrome 仅作为根容器承载入场/退场动画（MotionService 引用）。 -->
  <Border x:Name="WindowChrome"
          Background="#F7F7F8">
  <Grid x:Name="WindowRoot" PointerPressed="WindowRoot_OnPointerPressed">
    <Grid x:Name="AppShellGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="72" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" MinWidth="600" />
      </Grid.ColumnDefinitions>
      <!-- Sidebar: Fixed compact icon-only rail -->
      <Border x:Name="SidebarBorder" Grid.Column="0" Background="#F4F4F5" BorderThickness="0" ClipToBounds="True">
        <Grid x:Name="SidebarRoot" RowDefinitions="Auto,*,Auto" Margin="8,14,8,14">
          <Button Classes="sidebarCreate" Width="44" Height="44" Padding="0" HorizontalAlignment="Center"
                  Click="NewTask_OnClick" ToolTip.Tip="新建任务">
            <icons:MaterialIcon Kind="PlusCircleOutline" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>

          <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Grid>
              <StackPanel Spacing="6">
                <Button x:Name="OverviewNav" Classes="nav selected" Tag="overview" Click="Nav_OnClick" ToolTip.Tip="主页"
                        Width="44" Height="44" Padding="0" HorizontalAlignment="Center">
                  <icons:MaterialIcon Kind="ViewDashboardOutline" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="TasksNav" Classes="nav" Tag="tasks" Click="Nav_OnClick" ToolTip.Tip="任务概览"
                        Width="44" Height="44" Padding="0" HorizontalAlignment="Center">
                  <icons:MaterialIcon Kind="FormatListBulleted" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="ModelsNav" Classes="nav" Tag="models" Click="Nav_OnClick" ToolTip.Tip="语音识别"
                        Width="44" Height="44" Padding="0" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource AppIconMicrophoneStroked}" Width="19" Height="19" Foreground="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
              <Border x:Name="SidebarNavIndicator" Width="3" Height="26" Margin="0,9,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="2"
                      Background="#25272C" IsHitTestVisible="False" />
            </Grid>
          </StackPanel>

          <StackPanel Grid.Row="2" Spacing="6">
            <Border Height="1" Background="{StaticResource LineBrush}" Margin="4,0,4,10" />
            <Button x:Name="RecognitionNav" Classes="nav" Tag="recognition" Click="Nav_OnClick" ToolTip.Tip="翻译模型"
                    Width="44" Height="44" Padding="0" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource AppIconLanguage}" Width="19" Height="19" Foreground="{Binding $parent[Button].Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="SettingsNav" Classes="nav" Tag="settings" Click="Nav_OnClick" ToolTip.Tip="设置"
                    Width="44" Height="44" Padding="0" HorizontalAlignment="Center">
              <icons:MaterialIcon Kind="CogOutline" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sidebar divider -->
      <Border x:Name="SidebarDivider" Grid.Column="1" Width="1" HorizontalAlignment="Center"
              Background="{StaticResource LineBrush}" IsHitTestVisible="False" />

      <!-- Content -->
      <Border Grid.Column="2" Background="#F7F7F8">
        <Grid>
          <!-- Overview page -->
          <ScrollViewer x:Name="OverviewPage" Background="#F7F7F8" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,30,36,36" MaxWidth="1060" HorizontalAlignment="Stretch">
              <Grid Classes="motion-item" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="主页" Classes="pageTitle" />
                  <TextBlock Text="下午好，今天也让字幕变得简单一点。" Classes="muted" FontSize="13" Margin="0,7,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Click="NewTask_OnClick">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="Plus" Width="18" Height="18" />
                    <TextBlock Text="新建任务" />
                  </StackPanel>
                </Button>
              </Grid>

              <UniformGrid Columns="3" Margin="0,26,0,0">
                <Border Classes="card motion-item" Margin="0,0,8,0" Padding="20,18">
                  <Grid ColumnDefinitions="*,44">
                    <StackPanel>
                      <TextBlock Text="视频任务" Classes="muted" FontSize="12" />
                      <TextBlock x:Name="HomeVideoTaskCountText" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="#EEF6FD">
                      <icons:MaterialIcon Kind="Waveform" Width="22" Height="22" Foreground="#3399F3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </Border>
                <Border Classes="card motion-item" Margin="8,0" Padding="20,18">
                  <Grid ColumnDefinitions="*,44">
                    <StackPanel>
                      <TextBlock Text="累计识别时长" Classes="muted" FontSize="12" />
                      <TextBlock x:Name="HomeWeekTaskCountText" Text="0 分钟" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="#E8F8F0">
                      <icons:MaterialIcon Kind="CheckCircleOutline" Width="22" Height="22" Foreground="#278A68" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </Border>
                <Border Classes="card motion-item" Margin="8,0,0,0" Padding="20,18">
                  <Grid ColumnDefinitions="*,44">
                    <StackPanel>
                      <TextBlock Text="本地模型" Classes="muted" FontSize="12" />
                      <TextBlock x:Name="HomeLocalModelCountText" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="#EEF6FD">
                      <icons:MaterialIcon Kind="ServerOutline" Width="22" Height="22" Foreground="#3399F3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </Border>
              </UniformGrid>

              <Grid ColumnDefinitions="1.55*,1*" Margin="0,22,0,0">
                <Border Classes="card motion-item" Margin="0,0,10,0" Padding="0">
                  <Grid RowDefinitions="60,*">
                    <Grid Margin="20,0" ColumnDefinitions="*,Auto">
                      <TextBlock Text="最近任务" Classes="sectionTitle" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8" Click="TaskOverviewNav_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                          <TextBlock Text="查看全部" Foreground="#777A85" FontSize="12" />
                          <icons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Foreground="#777A85" />
                        </StackPanel>
                      </Button>
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="132">
                      <StackPanel x:Name="HomeRecentTaskHost" />
                      <StackPanel x:Name="HomeRecentTaskEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="FileVideoOutline" Width="24" Height="24" Foreground="#A4AAB3"
                                            HorizontalAlignment="Center" />
                        <TextBlock Text="还没有视频任务" Classes="muted" FontSize="11.5"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="16">
                  <Border Classes="card motion-item" Padding="20">
                    <StackPanel>
                      <TextBlock Text="快速开始" Classes="sectionTitle" />
                      <TextBlock Text="选择一个视频，立即建立字幕任务" Classes="muted" FontSize="12" Margin="0,6,0,15" />
                      <Button Classes="homeQuickStart" Click="NewTask_OnClick">
                        <StackPanel HorizontalAlignment="Center">
                          <Border Width="44" Height="44" CornerRadius="13" Background="#EEF6FD">
                            <icons:MaterialIcon Kind="TrayArrowUp" Width="23" Height="23" Foreground="#3399F3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="选择视频文件" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,11,0,0" />
                          <TextBlock Text="MP4、MOV、MKV、AVI、WEBM" Classes="muted" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                  <Border Classes="card motion-item" Padding="20">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock x:Name="HomeModelNameText" Text="尚未安装识别模型" FontSize="13" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                          <Border x:Name="HomeModelStatusDot" Width="7" Height="7" CornerRadius="4" Background="#A6ABB3" VerticalAlignment="Center" />
                          <TextBlock x:Name="HomeModelStatusText" Text="前往模型管理下载" Classes="muted" FontSize="11" />
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="secondary" Height="34" Padding="11,0" Click="ModelsNav_OnClick">
                        <TextBlock Text="管理模型" FontSize="12" FontWeight="Bold" />
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <!-- Task overview: every local video is one project/task row. -->
          <Grid x:Name="TasksPage" Background="#F7F7F8" IsVisible="False"
                RowDefinitions="Auto,Auto,*" Margin="36,30,36,26"
                MaxWidth="1060" HorizontalAlignment="Stretch">
              <Grid Grid.Row="0" Classes="motion-item" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="任务概览" Classes="pageTitle" />
                  <TextBlock Text="每个视频对应一个独立字幕任务，点击列表项即可继续处理。"
                             Classes="muted" FontSize="13" Margin="0,7,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Click="NewTask_OnClick">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="Plus" Width="18" Height="18" />
                    <TextBlock Text="新建任务" />
                  </StackPanel>
                </Button>
              </Grid>

              <Grid Grid.Row="1" Margin="0,25,0,12" ColumnDefinitions="*,Auto">
                <TextBlock Text="视频任务" Classes="sectionTitle" VerticalAlignment="Center" />
                <TextBlock x:Name="TaskOverviewCountText" Grid.Column="1" Text="0 个任务"
                           Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
              </Grid>

              <Border x:Name="TaskOverviewEmptyState" Grid.Row="2" Classes="card motion-item"
                      Padding="28,48" IsVisible="False" VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Center">
                  <Border Width="54" Height="54" CornerRadius="16" Background="#EEF6FD">
                    <icons:MaterialIcon Kind="FileVideoOutline" Width="26" Height="26" Foreground="#3399F3"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="还没有视频任务" FontSize="14" FontWeight="Bold"
                             HorizontalAlignment="Center" Margin="0,15,0,0" />
                  <TextBlock Text="点击右上角“新建任务”选择一个视频"
                             Classes="muted" FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <ListBox x:Name="TaskOverviewListHost" Grid.Row="2" Background="Transparent"
                       BorderThickness="0" Padding="0" Focusable="False">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
          </Grid>

          <!-- Translation model page -->
          <ScrollViewer x:Name="RecognitionPage" Background="#FFFFFF" IsVisible="False"
                        VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="280,*" Background="#FFFFFF">
              <!-- Compact provider rail with search and neutral selection feedback. -->
              <Grid RowDefinitions="Auto,*,Auto" Background="#FFFFFF">
                <Border Grid.RowSpan="3" Width="1" HorizontalAlignment="Right"
                        Background="#E5E7EB" ZIndex="2" IsHitTestVisible="False" />
                <Border Classes="translationProviderSearch" Margin="14,16,14,12" Height="40">
                  <Grid ColumnDefinitions="38,*">
                    <icons:MaterialIcon Kind="Magnify" Width="18" Height="18" Foreground="#747474"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox x:Name="TranslationProviderSearchBox" Grid.Column="1" Classes="translationProviderSearchInput"
                             Padding="0,0,12,0" FontSize="13.5"
                             VerticalContentAlignment="Center" PlaceholderText="搜索模型平台…"
                             TextChanged="TranslationProviderSearch_OnChanged" />
                  </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" Margin="0,0,0,12" Padding="14,0,8,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <StackPanel x:Name="TranslationProviderListHost" Spacing="5" />
                    <TextBlock x:Name="TranslationProviderEmptyText" Text="没有匹配的服务商" IsVisible="False"
                               Foreground="#999999" FontSize="12" TextAlignment="Center" Margin="8,24" />
                  </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="2" Classes="secondary" Height="40" Margin="14,0,14,16"
                        HorizontalAlignment="Stretch" Click="TranslationProviderAddCustom_OnClick">
                  <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="Plus" Width="17" Height="17" />
                    <TextBlock Text="添加自定义供应商" FontSize="12.5" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Flat detail column without row separators or oversized capsules. -->
              <Grid Grid.Column="1" x:Name="TranslationProfilePanel" RowDefinitions="Auto,*" Background="#FFFFFF">
                <Grid Margin="32,22,32,14" ColumnDefinitions="*,Auto" MaxWidth="880" HorizontalAlignment="Stretch">
                  <StackPanel>
                    <TextBlock x:Name="TranslationProviderTitleText" Text="DeepSeek" FontSize="22" FontWeight="Bold" Foreground="#18181B" />
                    <TextBlock Text="连接设置与模型管理" Foreground="#999999" FontSize="12" Margin="0,4,0,0" />
                  </StackPanel>
                  <ToggleSwitch x:Name="TranslationProviderEnableToggle" Grid.Column="1" OnContent="" OffContent=""
                                VerticalAlignment="Center" PropertyChanged="TranslationProviderEnable_OnChanged" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="32,10,32,32" MaxWidth="880" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel Spacing="8">
                      <TextBlock Text="接口协议" FontSize="14" FontWeight="SemiBold" Foreground="#18181B" />
                      <ComboBox x:Name="TranslationProtocolCombo" Classes="translationCombo"
                                HorizontalAlignment="Stretch" SelectionChanged="TranslationProtocol_OnChanged">
                        <ComboBoxItem Content="OpenAI Responses" Tag="openai-responses" />
                        <ComboBoxItem Content="OpenAI Chat Completions" Tag="openai-chat" />
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="7">
                      <TextBlock Text="API 地址" FontSize="14" FontWeight="SemiBold" Foreground="#18181B" />
                      <TextBox x:Name="TranslationBaseUrlBox" Classes="translationField translationCodeField"
                               PlaceholderText="https://api.example.com/v1">
                        <TextBox.InnerRightContent>
                          <Button x:Name="TranslationApiOptionsButton"
                                  Classes="translationInnerAction noButtonMotion"
                                  Click="TranslationApiOptions_OnClick" ToolTip.Tip="API 设置">
                            <icons:MaterialIcon Kind="CogOutline" Width="16" Height="16" />
                          </Button>
                        </TextBox.InnerRightContent>
                      </TextBox>
                    </StackPanel>

                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="API 密钥" FontSize="14" FontWeight="SemiBold" Foreground="#18181B" />
                        <TextBlock x:Name="TranslationApiKeyStateText" Grid.Column="1" Text="仅保存在本机"
                                   Foreground="#71717A" FontSize="11" Margin="8,2,0,0" />
                      </Grid>
                      <TextBox x:Name="TranslationApiKeyBox" Classes="translationField translationCodeField"
                               PasswordChar="●" PlaceholderText="输入 API 密钥">
                        <TextBox.InnerRightContent>
                          <Button x:Name="TranslationToggleKeyButton"
                                  Classes="translationInnerAction noButtonMotion"
                                  Click="TranslationToggleKey_OnClick" ToolTip.Tip="显示或隐藏 API 密钥">
                            <icons:MaterialIcon x:Name="TranslationToggleKeyIcon" Kind="EyeOutline" Width="16" Height="16" />
                          </Button>
                        </TextBox.InnerRightContent>
                      </TextBox>
                    </StackPanel>

                    <StackPanel Spacing="7">
                      <TextBlock Text="系统提示词" FontSize="14" FontWeight="SemiBold" Foreground="#18181B" />
                      <TextBox x:Name="TranslationPromptBox" Classes="translationField" Height="104"
                               Padding="14,12" AcceptsReturn="True" TextWrapping="Wrap"
                               FontWeight="SemiBold" Foreground="#4B5563"
                               VerticalContentAlignment="Top" PlaceholderText="输入系统提示词" />
                    </StackPanel>

                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="Auto,8,Auto,*,Auto">
                        <TextBlock Text="模型" FontSize="14" FontWeight="SemiBold" Foreground="#18181B" VerticalAlignment="Center" />
                        <TextBlock x:Name="TranslationModelCountText" Grid.Column="2" Text="0 个模型"
                                   FontSize="11.5" Foreground="#71717A" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Classes="translationModelActions">
                          <Grid ColumnDefinitions="Auto,1,36">
                            <Button x:Name="TranslationFetchModelsButton" Classes="translationModelActionSegment noButtonMotion"
                                    Click="TranslationFetchModels_OnClick">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="Refresh" Width="15" Height="15" />
                                <TextBlock Text="获取模型列表" FontSize="12.5" />
                              </StackPanel>
                            </Button>
                            <Border Grid.Column="1" Width="1" Background="#E5E7EB" IsHitTestVisible="False" />
                            <Button Grid.Column="2" Classes="translationModelActionSegment noButtonMotion" Width="36" Padding="0"
                                    Click="TranslationAddModel_OnClick" ToolTip.Tip="手动添加模型">
                              <icons:MaterialIcon Kind="Plus" Width="16" Height="16" />
                            </Button>
                          </Grid>
                        </Border>
                      </Grid>
                      <StackPanel Spacing="7">
                        <TextBlock Text="当前模型 ID" FontSize="13" FontWeight="SemiBold" Foreground="#18181B" />
                        <TextBox x:Name="TranslationModelBox" Classes="translationField translationCodeField" PlaceholderText="输入或选择模型 ID" />
                      </StackPanel>
                      <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14"
                              Background="#FFFFFF" MinHeight="130" UseLayoutRounding="True">
                        <!-- Keep the stroke outside the clipping surface so Avalonia does not cut off its corner arcs. -->
                        <Border Margin="1" CornerRadius="13" Background="#FFFFFF" ClipToBounds="True">
                          <Grid Background="#FFFFFF">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="3">
                              <StackPanel x:Name="TranslationModelListHost" Spacing="2" />
                            </ScrollViewer>
                            <StackPanel x:Name="TranslationModelEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <icons:MaterialIcon Kind="ArchiveOutline" Width="28" Height="28" Foreground="#C8C8C8" HorizontalAlignment="Center" />
                              <TextBlock Text="请选择模型" FontSize="12" Foreground="#747474" HorizontalAlignment="Center" Margin="0,8,0,0" />
                              <TextBlock Text="点击上方的获取模型列表按钮添加模型" FontSize="11" Foreground="#999999" Margin="0,4,0,0" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Border>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                      <TextBlock x:Name="TranslationSaveStatusText" Text="切换服务时会保留当前输入"
                                 FontSize="10.5" Foreground="#999999" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="translationAction noButtonMotion" Width="96"
                              Click="TranslationSave_OnClick">
                        <TextBlock Text="保存配置" FontWeight="SemiBold" />
                      </Button>
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>
          </ScrollViewer>

          <!-- Project page: a full-width production workflow for one local project. -->
          <Grid x:Name="ProjectPage" IsVisible="False" Background="#F7F7F8">
            <Grid x:Name="ProjectLayoutRoot" RowDefinitions="Auto,Auto,*" HorizontalAlignment="Stretch">
              <Grid x:Name="ProjectHeader" Margin="22,14,22,14" Classes="motion-item" ColumnDefinitions="1*,Auto,1*">
                <StackPanel MinWidth="0" Margin="0,0,16,0" VerticalAlignment="Center">
                  <TextBlock x:Name="ProjectTitleText" Text="字幕项目" Classes="pageTitle"
                             MinWidth="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border x:Name="ProjectSectionCapsule" Grid.Column="1" Height="46" Padding="4" CornerRadius="23" Background="#EEF0F3"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Grid>
                    <Border x:Name="ProjectSectionIndicator" Width="88" Height="38" CornerRadius="19"
                            HorizontalAlignment="Left" Background="#111827" IsHitTestVisible="False"
                            BoxShadow="0 3 10 0 #25111827">
                      <Border.Transitions>
                        <Transitions>
                          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut" />
                        </Transitions>
                      </Border.Transitions>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="ProjectFlowTab" ZIndex="1" Width="88" Classes="projectSectionTab selected" Tag="flow" Click="ProjectSection_OnClick">
                        <TextBlock Text="流程图" Foreground="{Binding $parent[Button].Foreground}" FontWeight="{Binding $parent[Button].FontWeight}" />
                      </Button>
                      <Button x:Name="ProjectTranscribeTab" ZIndex="1" Width="88" Classes="projectSectionTab" Tag="transcribe" Click="ProjectSection_OnClick">
                        <TextBlock Text="语音转录" Foreground="{Binding $parent[Button].Foreground}" FontWeight="{Binding $parent[Button].FontWeight}" />
                      </Button>
                      <Button x:Name="ProjectProcessTab" ZIndex="1" Width="88" Classes="projectSectionTab" Tag="process" Click="ProjectSection_OnClick">
                        <TextBlock Text="字幕处理" Foreground="{Binding $parent[Button].Foreground}" FontWeight="{Binding $parent[Button].FontWeight}" />
                      </Button>
                      <Button x:Name="ProjectTranslateTab" ZIndex="1" Width="88" Classes="projectSectionTab" Tag="translate" Click="ProjectSection_OnClick">
                        <TextBlock Text="字幕翻译" Foreground="{Binding $parent[Button].Foreground}" FontWeight="{Binding $parent[Button].FontWeight}" />
                      </Button>
                      <Button x:Name="ProjectWorkspaceTab" ZIndex="1" Width="88" Classes="projectSectionTab" Tag="workspace" Click="ProjectSection_OnClick">
                        <TextBlock Text="工作区" Foreground="{Binding $parent[Button].Foreground}" FontWeight="{Binding $parent[Button].FontWeight}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="ProjectHeaderExportAction" Height="38" Padding="20,0" CornerRadius="19"
                          Background="#3399F3" Foreground="White" BorderThickness="0"
                          FontWeight="Bold" FontSize="13.5"
                          Click="WorkspaceExport_OnClick" ToolTip.Tip="导出字幕或视频">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <icons:MaterialIcon Kind="TrayArrowUp" Width="17" Height="17" Foreground="White" VerticalAlignment="Center" />
                      <TextBlock Text="导出" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Grid>

              <!-- 顶部灰线：将胶囊按钮与下方视频/工作区完全分割 -->
              <Border x:Name="ProjectHeaderDivider" Grid.Row="1" Height="1" Background="#E1E5EA" />

              <Grid x:Name="ProjectSectionHost" Grid.Row="2" ClipToBounds="True">
              <Border x:Name="ProjectFlowView" Classes="projectCanvas motion-item" Margin="22,18,22,22" Padding="28,24,28,24"
                      VerticalAlignment="Stretch" MinHeight="520">
                <Grid RowDefinitions="Auto,*,Auto" VerticalAlignment="Stretch">
                  <!-- Flowchart Header Toolbar: Title, Mode Indicator Badge, Subtitle Processing Toggle, Mode Selector -->
                  <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <TextBlock Text="执行流程" FontSize="20" FontWeight="Bold" Foreground="#18181B" VerticalAlignment="Center" />
                      <Border x:Name="ProjectFlowModeBadge" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                              CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="ProjectFlowModeBadgeText" Text="视频 → 双语字幕 (4 步全流程)"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" />
                      </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <!-- Subtitle Processing Toggle -->
                      <Border Background="#F4F5F7" CornerRadius="18" Padding="12,4,14,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <icons:MaterialIcon Kind="TextBoxCheckOutline" Width="16" Height="16" Foreground="#4B5563" VerticalAlignment="Center" />
                          <TextBlock Text="字幕处理" FontSize="12.5" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center" />
                          <ToggleSwitch x:Name="ProjectSubtitleProcessingToggle" OnContent="" OffContent="" Margin="2,0,0,0"
                                        IsChecked="False" PropertyChanged="ProjectSubtitleProcessingToggle_OnChanged"
                                        ToolTip.Tip="启用或跳过第 3 步「字幕处理」（LLM 语义合并、错字校准与术语校对）" />
                        </StackPanel>
                      </Border>

                      <!-- Mode Selector Dropdown (No duplicate border, No emoji) -->
                      <ComboBox x:Name="ProjectWorkflowModeCombo" Classes="workflowModeCombo" Height="36" MinWidth="140"
                                FontSize="13" FontWeight="SemiBold" VerticalContentAlignment="Center"
                                SelectionChanged="ProjectWorkflowModeCombo_OnChanged">
                        <ComboBoxItem Tag="video-bilingual" Content="视频 → 双语字幕" />
                        <ComboBoxItem Tag="video-transcript" Content="视频 → 原文字幕" />
                        <ComboBoxItem Tag="subtitle-translation" Content="翻译已有字幕" />
                      </ComboBox>
                    </StackPanel>
                  </Grid>

                  <!-- 4 Stage Cards Grid -->
                  <Grid Grid.Row="1" ColumnDefinitions="*,38,*,38,*,38,*" VerticalAlignment="Center" Margin="0,6,0,6">
                    <!-- Stage 1: Video/Subtitle Import -->
                    <Border x:Name="ProjectImportStage" Grid.Column="0" Classes="projectStage motion-item"
                            Tag="flow" Cursor="Hand" PointerReleased="ProjectStage_OnPointerReleased">
                      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="ProjectImportStepNumberText" Text="01" FontSize="12" FontWeight="Bold" Foreground="#3399F3" />
                        </Grid>
                        <Border Grid.Row="1" Classes="projectStageIcon" Margin="0,22,0,0">
                          <icons:MaterialIcon x:Name="ProjectImportStageIcon" Kind="FileVideoOutline" Width="28" Height="28" Foreground="#3399F3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                          <TextBlock x:Name="ProjectImportTitleText" Text="视频导入" FontSize="18" FontWeight="Bold" />
                          <TextBlock x:Name="ProjectImportDescText" Text="选择本地视频，读取音轨和基础媒体信息。" FontSize="11" LineHeight="18" TextWrapping="Wrap" Foreground="#7F8792" Margin="0,7,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ProjectVideoNameText" Grid.Row="3" Text="尚未导入视频" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#8B919B" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Margin="0,0,0,13" />
                        <Button x:Name="ProjectImportAction" Grid.Row="4" Classes="primary" Content="选择视频"
                                HorizontalAlignment="Stretch" Click="ImportProjectVideo_OnClick" />
                      </Grid>
                    </Border>

                    <!-- Connector 1 -->
                    <Grid x:Name="ProjectTranscribeConnector" Grid.Column="1" VerticalAlignment="Center">
                      <Border Height="2" Margin="3,0" Background="#D8DDE4" CornerRadius="1" />
                      <Border Width="24" Height="24" CornerRadius="12" Background="#FFFFFF" BorderBrush="#D8DDE4" BorderThickness="1">
                        <icons:MaterialIcon Kind="ChevronRight" Width="15" Height="15" Foreground="#8B929D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>

                    <!-- Stage 2: Transcription -->
                    <Border x:Name="ProjectTranscribeStage" Grid.Column="2" Classes="projectStage motion-item"
                            Tag="transcribe" Cursor="Hand" PointerReleased="ProjectStage_OnPointerReleased">
                      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="02" FontSize="12" FontWeight="Bold" Foreground="#6A72D8" />
                          <Border Grid.Column="1" Classes="projectStageStatus"><TextBlock x:Name="ProjectTranscribeStatusText" Text="等待视频" FontSize="10.5" FontWeight="SemiBold" Foreground="#A0A5AD" VerticalAlignment="Center" /></Border>
                        </Grid>
                        <Border Grid.Row="1" Classes="projectStageIcon" Background="#F0F0FD" Margin="0,22,0,0">
                          <icons:MaterialIcon Kind="Waveform" Width="28" Height="28" Foreground="#6A72D8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                          <TextBlock Text="语音转录" FontSize="18" FontWeight="Bold" />
                          <TextBlock Text="调用本地语音模型，生成带时间轴的原文字幕。" FontSize="11" LineHeight="18" TextWrapping="Wrap" Foreground="#7F8792" Margin="0,7,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="识别模型与语言可配置" FontSize="10.5" Foreground="#A0A5AD" VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <!-- Connector 2 -->
                    <Grid x:Name="ProjectProcessConnector" Grid.Column="3" VerticalAlignment="Center">
                      <Border Height="2" Margin="3,0" Background="#D8DDE4" CornerRadius="1" />
                      <Border Width="24" Height="24" CornerRadius="12" Background="#FFFFFF" BorderBrush="#D8DDE4" BorderThickness="1">
                        <icons:MaterialIcon Kind="ChevronRight" Width="15" Height="15" Foreground="#8B929D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>

                    <!-- Stage 3: Subtitle Processing -->
                    <Border x:Name="ProjectProcessStage" Grid.Column="4" Classes="projectStage motion-item"
                            Tag="process" Cursor="Hand" PointerReleased="ProjectStage_OnPointerReleased">
                      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="03" FontSize="12" FontWeight="Bold" Foreground="#3399F3" />
                          <Border Grid.Column="1" Classes="projectStageStatus"><TextBlock x:Name="ProjectProcessStatusText" Text="等待转录" FontSize="10.5" FontWeight="SemiBold" Foreground="#A0A5AD" VerticalAlignment="Center" /></Border>
                        </Grid>
                        <Border Grid.Row="1" Classes="projectStageIcon" Background="#EDF6FF" Margin="0,22,0,0">
                          <icons:MaterialIcon Kind="TextBoxCheckOutline" Width="28" Height="28" Foreground="#3399F3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                          <TextBlock Text="字幕处理" FontSize="18" FontWeight="Bold" />
                          <TextBlock Text="联网验证术语，先校对原文，再按语义断句。" FontSize="11" LineHeight="18" TextWrapping="Wrap" Foreground="#7F8792" Margin="0,7,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="失败时保留原字幕，可单独重跑" FontSize="10.5" Foreground="#A0A5AD" VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <!-- Connector 3 -->
                    <Grid x:Name="ProjectTranslateConnector" Grid.Column="5" VerticalAlignment="Center">
                      <Border Height="2" Margin="3,0" Background="#D8DDE4" CornerRadius="1" />
                      <Border Width="24" Height="24" CornerRadius="12" Background="#FFFFFF" BorderBrush="#D8DDE4" BorderThickness="1">
                        <icons:MaterialIcon Kind="ChevronRight" Width="15" Height="15" Foreground="#8B929D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>

                    <!-- Stage 4: Subtitle Translation -->
                    <Border x:Name="ProjectTranslateStage" Grid.Column="6" Classes="projectStage motion-item"
                            Tag="translate" Cursor="Hand" PointerReleased="ProjectStage_OnPointerReleased">
                      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="04" FontSize="12" FontWeight="Bold" Foreground="#E69A31" />
                          <Border Grid.Column="1" Classes="projectStageStatus"><TextBlock x:Name="ProjectTranslateStatusText" Text="等待转录" FontSize="10.5" FontWeight="SemiBold" Foreground="#A0A5AD" VerticalAlignment="Center" /></Border>
                        </Grid>
                        <Border Grid.Row="1" Classes="projectStageIcon" Background="#FFF6E9" Margin="0,22,0,0">
                          <PathIcon Data="{StaticResource AppIconLanguage}" Width="27" Height="27" Foreground="#E69A31" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                          <TextBlock Text="字幕翻译" FontSize="18" FontWeight="Bold" />
                          <TextBlock Text="按语义和时间轴翻译字幕，并保留上下文一致性。" FontSize="11" LineHeight="18" TextWrapping="Wrap" Foreground="#7F8792" Margin="0,7,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="可选择目标语言与翻译模型" FontSize="10.5" Foreground="#A0A5AD" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </Grid>

                  <!-- Flowchart bottom bar: status stays beside the action instead of overflowing a stage badge. -->
                  <Grid Grid.Row="2" Margin="0,16,0,0" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                    <Border x:Name="ProjectFlowStatusBorder" Grid.Column="0" IsVisible="False"
                            MaxWidth="560" Height="42" Margin="0,0,12,0" Padding="16,0"
                            HorizontalAlignment="Right" CornerRadius="21" Background="#FFF1F1">
                      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="AlertCircleOutline" Width="17" Height="17" Foreground="#D64545" />
                        <TextBlock x:Name="ProjectFlowStatusText" Grid.Column="1" Margin="8,0,0,0"
                                   Foreground="#D64545" FontSize="11.5"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                    <Button x:Name="ProjectFlowStartAction" Grid.Column="1" Classes="primary" Height="42" Padding="28,0"
                            CornerRadius="21" FontWeight="Bold" FontSize="14"
                            Click="ProjectFlowStartAction_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock x:Name="ProjectFlowStartText" Text="开始" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Grid>
              </Border>

              <Border x:Name="ProjectTranscribeView" Classes="projectCanvas" Margin="22,18,22,22" IsVisible="False" Padding="0" MinHeight="470">
                <Grid RowDefinitions="64,*">
                  <Border Padding="24,0" BorderBrush="#E8EAEE" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="语音转录" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="选择本地识别模型并配置当前项目的转录参数" FontSize="11" Foreground="#858D98" Margin="0,4,0,0" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="projectStageStatus" VerticalAlignment="Center">
                        <TextBlock Text="步骤 2 / 4" Foreground="#6A72D8" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Border>

                  <Grid Grid.Row="1" ColumnDefinitions="340,*" Margin="18">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="10">
                        <Border Classes="settingsPanel" Padding="16,14">
                          <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock Text="识别模型" FontSize="12.5" FontWeight="Bold" />
                                <TextBlock Text="仅显示已经部署到本机的模型" FontSize="10" Foreground="#8C939D" Margin="0,3,0,0" />
                              </StackPanel>
                              <Button Grid.Column="1" Classes="secondary" Height="28" MinWidth="64" Padding="10,0" Click="ModelsNav_OnClick">
                                <TextBlock Text="管理模型" FontSize="10.5" FontWeight="Bold" />
                              </Button>
                            </Grid>
                            <ComboBox x:Name="ProjectTranscriptionModelCombo" Classes="settingSelect" Height="34"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            <TextBlock x:Name="ProjectTranscriptionModelEmpty" Text="当前没有可用模型，请先前往模型配置下载。"
                                       FontSize="10" Foreground="#D18B2D" TextWrapping="Wrap" IsVisible="False" />
                          </StackPanel>
                        </Border>

                        <Border Classes="settingsPanel" Padding="16,14">
                          <StackPanel Spacing="8">
                            <TextBlock Text="转录参数配置" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" />

                            <!-- ================= 下拉选择组 ================= -->
                            <!-- 运行设备 -->
                            <Border x:Name="ProjectTranscriptionDeviceRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="运行设备" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <ComboBox x:Name="ProjectTranscriptionDeviceCombo" Grid.Column="1" Classes="settingSelect" Height="32" Width="150" HorizontalAlignment="Right" SelectedIndex="0">
                                  <ComboBoxItem Content="自动选择" />
                                  <ComboBoxItem Content="CUDA 显卡" />
                                  <ComboBoxItem Content="CPU" />
                                </ComboBox>
                              </Grid>
                            </Border>

                            <!-- 识别语言 -->
                            <Border x:Name="ProjectTranscriptionLanguageRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="识别语言" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <ComboBox x:Name="ProjectTranscriptionLanguageCombo" Grid.Column="1" Classes="settingSelect" Height="32" Width="150" HorizontalAlignment="Right" SelectedIndex="0">
                                  <ComboBoxItem Content="自动检测" Tag="" />
                                </ComboBox>
                              </Grid>
                            </Border>

                            <!-- 计算精度 -->
                            <Border x:Name="ProjectTranscriptionPrecisionRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="计算精度" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <ComboBox x:Name="ProjectTranscriptionPrecisionCombo" Grid.Column="1" Classes="settingSelect" Height="32" Width="150" HorizontalAlignment="Right" SelectedIndex="0">
                                  <ComboBoxItem Content="自动" />
                                  <ComboBoxItem Content="Float16" />
                                  <ComboBoxItem Content="Int8" />
                                </ComboBox>
                              </Grid>
                            </Border>

                            <!-- 说话人数 -->
                            <Border x:Name="ProjectTranscriptionSpeakerCountRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="说话人数" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <ComboBox x:Name="ProjectTranscriptionSpeakerCountCombo" Grid.Column="1" Classes="settingSelect" Height="32" Width="150" HorizontalAlignment="Right" SelectedIndex="0">
                                  <ComboBoxItem Content="自动检测" />
                                  <ComboBoxItem Content="2 人" />
                                  <ComboBoxItem Content="3 人" />
                                  <ComboBoxItem Content="4 人" />
                                  <ComboBoxItem Content="5 人以上" />
                                </ComboBox>
                              </Grid>
                            </Border>

                            <Border Height="1" Background="#ECEDEF" Margin="0,2" />

                            <!-- ================= 数值调节组 ================= -->
                            <!-- 搜索宽度 (Beam Size) -->
                            <Border x:Name="ProjectTranscriptionBeamRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="搜索宽度 (Beam)" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,40" Width="150" HorizontalAlignment="Right">
                                  <Slider x:Name="ProjectTranscriptionBeamSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                  <TextBlock x:Name="ProjectTranscriptionBeamText" Grid.Column="1" Text="5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" />
                                </Grid>
                              </Grid>
                            </Border>

                            <!-- 采样温度 (Temperature) -->
                            <Border x:Name="ProjectTranscriptionTemperatureRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="采样温度" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,40" Width="150" HorizontalAlignment="Right">
                                  <Slider x:Name="ProjectTranscriptionTemperatureSlider" Minimum="0" Maximum="1" Value="0.2" TickFrequency="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                  <TextBlock x:Name="ProjectTranscriptionTemperatureText" Grid.Column="1" Text="0.2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" />
                                </Grid>
                              </Grid>
                            </Border>

                            <!-- VAD 灵敏度阈值 -->
                            <Border x:Name="ProjectTranscriptionVadThresholdRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="VAD 灵敏度阈值" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,40" Width="150" HorizontalAlignment="Right">
                                  <Slider x:Name="ProjectTranscriptionVadThresholdSlider" Minimum="0.1" Maximum="0.9" Value="0.3" TickFrequency="0.05" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                  <TextBlock x:Name="ProjectTranscriptionVadThresholdText" Grid.Column="1" Text="0.30" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" />
                                </Grid>
                              </Grid>
                            </Border>

                            <!-- 最短静音切分时长 -->
                            <Border x:Name="ProjectTranscriptionVadMinSilenceRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="最短静音切分" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,52" Width="150" HorizontalAlignment="Right">
                                  <Slider x:Name="ProjectTranscriptionVadMinSilenceSlider" Minimum="500" Maximum="5000" Value="2000" TickFrequency="100" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                  <TextBlock x:Name="ProjectTranscriptionVadMinSilenceText" Grid.Column="1" Text="2000ms" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="10.5" />
                                </Grid>
                              </Grid>
                            </Border>

                            <!-- 语音边缘缓冲填充 -->
                            <Border x:Name="ProjectTranscriptionVadSpeechPadRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="语音边缘缓冲" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,48" Width="150" HorizontalAlignment="Right">
                                  <Slider x:Name="ProjectTranscriptionVadSpeechPadSlider" Minimum="0" Maximum="1000" Value="400" TickFrequency="50" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                  <TextBlock x:Name="ProjectTranscriptionVadSpeechPadText" Grid.Column="1" Text="400ms" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="10.5" />
                                </Grid>
                              </Grid>
                            </Border>

                            <!-- 最大生成长度 -->
                            <Border x:Name="ProjectTranscriptionMaxTokensRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="最大生成长度" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,40" Width="150" HorizontalAlignment="Right">
                                  <Slider x:Name="ProjectTranscriptionMaxTokensSlider" Minimum="128" Maximum="1024" Value="512" TickFrequency="128" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                  <TextBlock x:Name="ProjectTranscriptionMaxTokensText" Grid.Column="1" Text="512" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" />
                                </Grid>
                              </Grid>
                            </Border>

                            <!-- 音频分块时长 -->
                            <Border x:Name="ProjectTranscriptionChunkSecondsRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="音频分块时长" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,40" Width="150" HorizontalAlignment="Right">
                                  <Slider x:Name="ProjectTranscriptionChunkSecondsSlider" Minimum="10" Maximum="60" Value="30" TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                  <TextBlock x:Name="ProjectTranscriptionChunkSecondsText" Grid.Column="1" Text="30s" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" />
                                </Grid>
                              </Grid>
                            </Border>

                            <Border Height="1" Background="#ECEDEF" Margin="0,2" />

                            <!-- ================= 功能开关组 ================= -->
                            <!-- 静音过滤 (VAD) -->
                            <Border x:Name="ProjectTranscriptionVadRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="静音过滤 (VAD)" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="ProjectTranscriptionVadToggle" Grid.Column="1" IsChecked="True" OnContent="" OffContent="" HorizontalAlignment="Right" VerticalAlignment="Center" />
                              </Grid>
                            </Border>

                            <!-- 词级时间戳 -->
                            <Border x:Name="ProjectTranscriptionTimestampRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="词级时间戳" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="ProjectTranscriptionWordTimestampsToggle" Grid.Column="1" IsChecked="True" OnContent="" OffContent="" HorizontalAlignment="Right" VerticalAlignment="Center" />
                              </Grid>
                            </Border>

                            <!-- 说话人分离 -->
                            <Border x:Name="ProjectTranscriptionDiarizationRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="说话人分离" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="ProjectTranscriptionDiarizationToggle" Grid.Column="1" IsChecked="True" OnContent="" OffContent="" HorizontalAlignment="Right" VerticalAlignment="Center" />
                              </Grid>
                            </Border>

                            <!-- 情绪识别 -->
                            <Border x:Name="ProjectTranscriptionEmotionRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="情绪识别" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="ProjectTranscriptionEmotionToggle" Grid.Column="1" IsChecked="True" OnContent="" OffContent="" HorizontalAlignment="Right" VerticalAlignment="Center" />
                              </Grid>
                            </Border>

                            <!-- 声音事件识别 -->
                            <Border x:Name="ProjectTranscriptionAudioEventRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="声音事件识别" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="ProjectTranscriptionAudioEventToggle" Grid.Column="1" IsChecked="True" OnContent="" OffContent="" HorizontalAlignment="Right" VerticalAlignment="Center" />
                              </Grid>
                            </Border>

                            <Border Height="1" Background="#ECEDEF" Margin="0,2" />

                            <!-- ================= 文本输入组 ================= -->
                            <!-- 热词 -->
                            <Border x:Name="ProjectTranscriptionHotwordsRow">
                              <Grid ColumnDefinitions="*,150">
                                <TextBlock Text="热词提示" FontSize="12" FontWeight="SemiBold" Foreground="#2A2D34" VerticalAlignment="Center" />
                                <TextBox x:Name="ProjectTranscriptionHotwordsBox" Grid.Column="1" Classes="settingInput" Height="30" Width="150" HorizontalAlignment="Right" Padding="8,4" FontSize="11" PlaceholderText="例如：AstraCat, Qwen" />
                              </Grid>
                            </Border>

                            <Border Height="1" Background="#ECEDEF" Margin="0,4,0,4" />

                            <!-- ================= 操作按钮 ================= -->
                            <Grid ColumnDefinitions="*,Auto">
                              <Button x:Name="ProjectResetTranscriptionDefaultsButton" Classes="actionLink" Padding="4,2" Click="ProjectResetTranscriptionDefaults_OnClick" ToolTip.Tip="重置为当前模型保存在本地的默认配置">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <icons:MaterialIcon Kind="Restore" Width="14" Height="14" Foreground="#6B7280" />
                                  <TextBlock Text="恢复默认配置" FontSize="11" Foreground="#6B7280" />
                                </StackPanel>
                              </Button>
                              <Button x:Name="ProjectSaveTranscriptionDefaultsButton" Grid.Column="1" Classes="actionLink" Padding="4,2" Click="ProjectSaveTranscriptionDefaults_OnClick" ToolTip.Tip="将当前项目参数保存为该模型的全局默认模板">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <icons:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14" Foreground="#3399F3" />
                                  <TextBlock Text="设为默认配置" FontSize="11" Foreground="#3399F3" />
                                </StackPanel>
                              </Button>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Margin="18,0,0,0" Background="#F8F9FA" BorderBrush="#E7E9ED" BorderThickness="1" CornerRadius="13" Padding="28">
                      <Grid>
                      <Grid x:Name="ProjectTranscriptionMainPanel" RowDefinitions="*,Auto,Auto">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                          <Border Width="74" Height="74" CornerRadius="24" Background="#EEEEFC" HorizontalAlignment="Center">
                            <icons:MaterialIcon Kind="Waveform" Width="36" Height="36" Foreground="#6A72D8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="准备语音转录" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                          <TextBlock x:Name="ProjectTranscriptionSourceText" Text="请先在流程图中导入视频" FontSize="11.5" Foreground="#838B97"
                                     TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0" />
                          <Border Margin="0,22,0,0" Padding="16,11" CornerRadius="11" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*">
                              <Border x:Name="ProjectTranscriptionStatusDot" Width="9" Height="9" CornerRadius="5" Background="#C5C9D0" VerticalAlignment="Center" />
                              <TextBlock x:Name="ProjectTranscriptionReadyText" Grid.Column="1" Text="等待视频和识别模型" FontSize="11" FontWeight="SemiBold" Foreground="#7F8792" Margin="9,0,0,0" />
                            </Grid>
                          </Border>
                        </StackPanel>
                        <StackPanel x:Name="ProjectTranscriptionProgressPanel" Grid.Row="1" Margin="0,0,0,13" Spacing="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="转录进度" FontSize="10.5" FontWeight="SemiBold" Foreground="#7F8792" />
                            <TextBlock x:Name="ProjectTranscriptionProgressText" Grid.Column="1" Text="0 %"
                                       FontSize="10.5" FontWeight="Bold" Foreground="#3399F3" />
                          </Grid>
                          <ProgressBar x:Name="ProjectTranscriptionProgress" Height="7" Minimum="0" Maximum="100" Value="0"
                                       IsIndeterminate="False" Foreground="#3399F3" Background="#E4E7EB" />
                        </StackPanel>
                        <Grid Grid.Row="2" ColumnDefinitions="*,10,Auto">
                          <Button x:Name="ProjectStartTranscriptionAction" Classes="primary" Height="44" CornerRadius="22"
                                  HorizontalAlignment="Stretch" IsEnabled="False" Click="ProjectStartTranscription_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><icons:MaterialIcon Kind="Play" Width="18" Height="18" /><TextBlock x:Name="ProjectStartTranscriptionText" Text="开始转录" FontWeight="Bold" /></StackPanel>
                          </Button>
                          <Button x:Name="ProjectCancelTranscriptionAction" Grid.Column="2" Classes="secondary" Height="44" MinWidth="82"
                                  Padding="16,0" CornerRadius="22" Content="取消" IsVisible="False" Click="ProjectCancelTranscription_OnClick" />
                        </Grid>
                      </Grid>

                      <Grid x:Name="ProjectTranscriptionLogPanel" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,46,0" VerticalAlignment="Center">
                          <Grid Width="26" Height="26" RowDefinitions="11,4,11" ColumnDefinitions="11,4,11">
                            <Border x:Name="ProjectTranscriptionLogTileTopLeft" Grid.Row="0" Grid.Column="0"
                                    Background="#747982" CornerRadius="4,1.5,1.5,1.5" />
                            <Border x:Name="ProjectTranscriptionLogTileTopRight" Grid.Row="0" Grid.Column="2"
                                    Background="#747982" CornerRadius="1.5,4,1.5,1.5" />
                            <Border x:Name="ProjectTranscriptionLogTileBottomLeft" Grid.Row="2" Grid.Column="0"
                                    Background="#747982" CornerRadius="1.5,1.5,1.5,4" />
                            <Border x:Name="ProjectTranscriptionLogTileBottomRight" Grid.Row="2" Grid.Column="2"
                                    Background="#747982" CornerRadius="1.5,1.5,4,1.5" />
                          </Grid>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="语音转录日志" FontSize="15" FontWeight="Bold" Foreground="#252B33" />
                            <TextBlock x:Name="ProjectTranscriptionLogStateText" Text="等待转录任务"
                                       Margin="0,2,0,0" FontSize="10.5" Foreground="#858D98" />
                          </StackPanel>
                        </StackPanel>
                        <TextBox x:Name="ProjectTranscriptionLogText" Grid.Row="1" Classes="transcriptionLog" Text="尚未开始转录。"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="11.5"
                                 Padding="16" Background="#171A20" Foreground="#DCE4EE"
                                 BorderBrush="#2B313A" BorderThickness="1" CornerRadius="14" />
                      </Grid>

                      <Button x:Name="ProjectTranscriptionLogButton" ZIndex="5" Width="34" Height="34" Padding="0"
                              HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="17"
                              Background="#EEF0F3" Foreground="#59636F" BorderThickness="0"
                              Click="ProjectTranscriptionLog_OnClick" ToolTip.Tip="查看转录日志">
                        <Grid>
                          <icons:MaterialIcon x:Name="ProjectTranscriptionLogOpenIcon" Kind="FileDocumentOutline"
                                              Width="17" Height="17" />
                          <icons:MaterialIcon x:Name="ProjectTranscriptionLogBackIcon" Kind="ArrowLeft"
                                              Width="17" Height="17" IsVisible="False" />
                        </Grid>
                      </Button>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </Border>

              <Border x:Name="ProjectProcessView" Classes="projectCanvas" Margin="22,18,22,22" IsVisible="False" Padding="0" MinHeight="470">
                <Grid RowDefinitions="64,*">
                  <Border Padding="24,0" BorderBrush="#E8EAEE" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="字幕处理" FontSize="17" FontWeight="Bold" />
                          <TextBlock Text="联网术语研究 → 原文校对 → LLM 语义断句" FontSize="11" Foreground="#858D98" Margin="0,4,0,0" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="projectStageStatus" VerticalAlignment="Center">
                        <TextBlock Text="步骤 3 / 4" Foreground="#3399F3" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Border>

                  <Grid Grid.Row="1" ColumnDefinitions="360,*" Margin="18">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="10">
                        <Border Classes="settingsPanel" Padding="16,14">
                          <StackPanel Spacing="10">
                            <StackPanel>
                              <TextBlock Text="处理模型" FontSize="12.5" FontWeight="Bold" />
                              <TextBlock Text="复用“翻译模型”中已经保存的接口与密钥" FontSize="10" Foreground="#8C939D" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="ProjectProcessingProviderCombo" Classes="settingSelect" Height="34" HorizontalAlignment="Stretch" />
                          </StackPanel>
                        </Border>

                        <Border Classes="settingsPanel" Padding="16,14">
                          <StackPanel Spacing="10">
                            <TextBlock Text="处理流程" FontSize="12.5" FontWeight="Bold" />
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel><TextBlock Text="联网术语检索" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="搜索专名与术语，只作为校对证据" FontSize="9.5" Foreground="#9299A3" Margin="0,2,0,0" /></StackPanel>
                              <ToggleSwitch x:Name="ProjectWebResearchToggle" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="#ECEDEF" />
                            <Grid ColumnDefinitions="*,Auto">
                                  <StackPanel><TextBlock Text="原文校对" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="保持原语言，只用已验证术语修正专名" FontSize="9.5" Foreground="#9299A3" Margin="0,2,0,0" /></StackPanel>
                              <ToggleSwitch x:Name="ProjectProofreadingToggle" Grid.Column="1" IsChecked="False" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="#ECEDEF" />
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel><TextBlock Text="LLM 语义断句" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="保持校对后的原字词，只调整字幕切分" FontSize="9.5" Foreground="#9299A3" Margin="0,2,0,0" /></StackPanel>
                              <ToggleSwitch x:Name="ProjectSegmentationToggle" Grid.Column="1" IsChecked="True" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                            <Border x:Name="ProjectEnglishWordLimitRow" Margin="0,2,0,0">
                              <Grid ColumnDefinitions="*,140">
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="单词数限制" FontSize="11" FontWeight="SemiBold" />
                                  <TextBlock Text="英文等拉丁语系每个分句的最大单词数" FontSize="9.5" Foreground="#9299A3" Margin="0,2,0,0" />
                                </StackPanel>
                                <Grid Grid.Column="1" ColumnDefinitions="*,36">
                                  <Slider x:Name="ProjectEnglishWordLimitSlider" Minimum="4" Maximum="30" Value="12" TickFrequency="1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                  <TextBlock x:Name="ProjectEnglishWordLimitText" Grid.Column="1" Text="12 词" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="10.5" />
                                </Grid>
                              </Grid>
                            </Border>
                          </StackPanel>
                        </Border>

                        <Border Classes="settingsPanel" Padding="16,14">
                          <StackPanel Spacing="6">
                            <TextBlock Text="自定义处理要求" FontSize="12" FontWeight="Bold" />
                            <TextBox x:Name="ProjectProcessingPromptBox" Height="58" Padding="12,8" AcceptsReturn="True"
                                     CornerRadius="14" TextWrapping="Wrap" VerticalContentAlignment="Top" PlaceholderText="例如：保留 Minecraft 模组名和玩家名原文" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Margin="18,0,0,0" Background="#F8F9FA" BorderBrush="#E7E9ED" BorderThickness="1" CornerRadius="13" Padding="28">
                      <Grid>
                      <Grid x:Name="ProjectProcessingMainPanel" RowDefinitions="*,Auto,Auto">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                          <Border Width="74" Height="74" CornerRadius="24" Background="#EAF4FE" HorizontalAlignment="Center">
                            <icons:MaterialIcon Kind="TextBoxCheckOutline" Width="36" Height="36" Foreground="#3399F3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="准备优化字幕" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                          <TextBlock x:Name="ProjectProcessingSummaryText" Text="请先完成语音转录或加载字幕" FontSize="11.5" Foreground="#838B97"
                                     TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0" />
                          <Border Margin="0,22,0,0" Padding="16,12" CornerRadius="11" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*">
                              <Border x:Name="ProjectProcessingStatusDot" Width="9" Height="9" CornerRadius="5" Background="#C5C9D0" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                <TextBlock x:Name="ProjectProcessingStatusText" Text="等待原字幕" FontSize="11" FontWeight="SemiBold" Foreground="#7F8792" />
                                <TextBlock x:Name="ProjectProcessingDetailText" Text="处理结果会自动保存，不覆盖最初的识别文件" FontSize="10" Foreground="#9AA0AA" Margin="0,3,0,0" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </StackPanel>
                        <ProgressBar x:Name="ProjectProcessingProgress" Grid.Row="1" Height="5" Margin="0,0,0,13"
                                     Minimum="0" Maximum="100" Value="0" Foreground="#3399F3" Background="#E4E7EB" />
                        <Grid Grid.Row="2" ColumnDefinitions="*,10,Auto">
                          <Button x:Name="ProjectStartProcessingAction" Classes="primary" Height="44" CornerRadius="22"
                                  HorizontalAlignment="Stretch" IsEnabled="False" Click="ProjectStartProcessing_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><icons:MaterialIcon Kind="Play" Width="18" Height="18" /><TextBlock x:Name="ProjectStartProcessingText" Text="开始处理" FontWeight="Bold" /></StackPanel>
                          </Button>
                          <Button x:Name="ProjectCancelProcessingAction" Grid.Column="2" Classes="secondary" Height="44" MinWidth="82"
                                  Padding="16,0" CornerRadius="22" Content="取消" IsVisible="False" Click="ProjectCancelProcessing_OnClick" />
                        </Grid>
                      </Grid>
                      <Grid x:Name="ProjectProcessingResearchPanel" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Border Width="38" Height="38" CornerRadius="12" Background="#EAF4FE">
                            <icons:MaterialIcon Kind="FileDocumentOutline" Width="21" Height="21" Foreground="#3399F3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProjectProcessingResearchStateText" Text="AI 术语摘要" FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="只有 verified 术语会参与自动校对和翻译" FontSize="9.5" Foreground="#8C939D" />
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Height="34" Padding="12,0" CornerRadius="17"
                                Click="ProjectProcessingResearchRefresh_OnClick" ToolTip.Tip="下次处理时绕过缓存">
                          <StackPanel Orientation="Horizontal" Spacing="5"><icons:MaterialIcon Kind="Refresh" Width="15" Height="15" /><TextBlock Text="刷新研究" FontSize="10.5" FontWeight="Bold" /></StackPanel>
                        </Button>
                        </Grid>
                        <TextBox x:Name="ProjectProcessingResearchText" Grid.Row="1" Text="尚未生成术语研究摘要。" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="13" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="10.5" />
                      </Grid>
                      <Button x:Name="ProjectProcessingResearchButton" ZIndex="5" Width="34" Height="34" Padding="0"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                              Background="#FFFFFF" BorderBrush="#E2E5E9" BorderThickness="1" CornerRadius="10"
                              Click="ProjectProcessingResearch_OnClick" ToolTip.Tip="查看 AI 术语摘要">
                        <Grid>
                          <icons:MaterialIcon x:Name="ProjectProcessingResearchOpenIcon" Kind="FileDocumentOutline" Width="17" Height="17" Foreground="#59616C" />
                          <icons:MaterialIcon x:Name="ProjectProcessingResearchBackIcon" Kind="ArrowLeft" Width="17" Height="17" Foreground="#59616C" IsVisible="False" />
                        </Grid>
                      </Button>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </Border>

              <Border x:Name="ProjectTranslateView" Classes="projectCanvas" Margin="22,18,22,22" IsVisible="False" Padding="0" MinHeight="500">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                  <!-- Project command bar for editing and processing actions. -->
                  <Grid Margin="20,16,20,12" ColumnDefinitions="*,Auto,10,Auto,10,Auto,10,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="字幕优化与翻译" FontSize="15" FontWeight="Bold" />
                      <TextBlock x:Name="ProjectTranslationFileText" Text="请先加载 SRT 字幕文件"
                                 FontSize="10.5" Foreground="#858D98" Margin="0,4,0,0" />
                      <TextBlock x:Name="ProjectTranslationSettingsSummaryText" Text="DeepSeek · 简体中文 · 译文在上"
                                 FontSize="10" Foreground="#3399F3" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="secondary" Height="36" Padding="13,0"
                            Click="ProjectTranslationSettings_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="6"><icons:MaterialIcon Kind="CogOutline" Width="16" Height="16" /><TextBlock Text="设置" /></StackPanel>
                    </Button>
                    <Button Grid.Column="3" Classes="secondary" Height="36" Padding="13,0"
                            Click="ProjectLoadSubtitle_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="6"><icons:MaterialIcon Kind="FolderPlusOutline" Width="16" Height="16" /><TextBlock Text="加载字幕" /></StackPanel>
                    </Button>
                    <Button Grid.Column="5" x:Name="ProjectSaveSubtitleAction" Classes="secondary" Height="36" Padding="13,0"
                            IsEnabled="False" Click="ProjectSaveSubtitle_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="6"><icons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16" /><TextBlock Text="保存字幕" /></StackPanel>
                    </Button>
                    <Button Grid.Column="7" x:Name="ProjectStartTranslationAction" Classes="primary" Height="36" Padding="15,0"
                            IsEnabled="False" Click="ProjectStartTranslation_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="6"><icons:MaterialIcon Kind="Play" Width="16" Height="16" /><TextBlock x:Name="ProjectStartTranslationText" Text="开始翻译" /></StackPanel>
                    </Button>
                  </Grid>

                  <Border Grid.Row="1" IsVisible="False" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Background="#FBFBFC">
                    <Grid Margin="20,13" ColumnDefinitions="1.2*,12,1*,12,1*,12,Auto,18,Auto">
                      <StackPanel>
                        <TextBlock Text="翻译模型" FontSize="10.5" Foreground="#858D98" Margin="2,0,0,5" />
                        <ComboBox x:Name="ProjectTranslationProviderCombo" Classes="settingSelect" Height="34"
                                  SelectionChanged="ProjectTranslationSettings_OnChanged" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="目标语言" FontSize="10.5" Foreground="#858D98" Margin="2,0,0,5" />
                        <ComboBox x:Name="ProjectTranslationTargetCombo" Classes="settingSelect" Height="34"
                                  SelectionChanged="ProjectTranslationSettings_OnChanged">
                          <ComboBoxItem Content="简体中文" /><ComboBoxItem Content="繁体中文" />
                          <ComboBoxItem Content="英语" /><ComboBoxItem Content="日语" />
                          <ComboBoxItem Content="韩语" /><ComboBoxItem Content="法语" />
                          <ComboBoxItem Content="德语" /><ComboBoxItem Content="西班牙语" />
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="4">
                        <TextBlock Text="字幕排布" FontSize="10.5" Foreground="#858D98" Margin="2,0,0,5" />
                        <ComboBox x:Name="ProjectSubtitleLayoutCombo" Classes="settingSelect" Height="34"
                                  SelectionChanged="ProjectTranslationSettings_OnChanged">
                          <ComboBoxItem Content="译文在上" /><ComboBoxItem Content="原文在上" />
                          <ComboBoxItem Content="仅译文" /><ComboBoxItem Content="仅原文" />
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <TextBlock Text="字幕校正" FontSize="10.5" Foreground="#858D98" HorizontalAlignment="Center" Margin="0,0,0,7" />
                        <ToggleSwitch x:Name="ProjectCorrectionToggle" HorizontalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Grid.Column="8" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <TextBlock Text="反思翻译" FontSize="10.5" Foreground="#858D98" HorizontalAlignment="Center" Margin="0,0,0,7" />
                        <ToggleSwitch x:Name="ProjectReflectToggle" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid Grid.Row="2" RowDefinitions="40,*" MinHeight="280">
                    <Grid Background="#F6F7F9" ColumnDefinitions="50,120,120,*,*">
                      <TextBlock Text="#" Foreground="#4B5563" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="开始时间" Foreground="#4B5563" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="结束时间" Foreground="#4B5563" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="原字幕" Foreground="#4B5563" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="翻译字幕" Foreground="#4B5563" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1">
                      <ListBox x:Name="ProjectTranslationTableHost"
                               Background="Transparent"
                               BorderThickness="0"
                               Padding="0"
                               SelectionMode="Single"
                               ItemContainerTheme="{StaticResource AstraSubtitleListItemTheme}"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                          </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                      </ListBox>
                      <StackPanel x:Name="ProjectTranslationEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource AppIconLanguage}" Width="30" Height="30" Foreground="#B2B7BF" HorizontalAlignment="Center" />
                        <TextBlock Text="加载 SRT 字幕后即可校对并翻译" FontSize="11.5" Foreground="#858D98" Margin="0,10,0,0" />
                      </StackPanel>
                    </Grid>
                  </Grid>

                  <Grid Grid.Row="3" Margin="20,13" ColumnDefinitions="*,Auto,10,Auto">
                    <ProgressBar x:Name="ProjectTranslationProgress" Height="5" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#3399F3" Background="#E5E7EB" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProjectTranslationStatusText" Grid.Column="1" Text="等待加载字幕"
                               FontSize="10.5" Foreground="#7E8794" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <Button x:Name="ProjectTranslationCancelAction" Grid.Column="3" Classes="secondary" Height="30"
                            Padding="12,0" Content="取消" IsVisible="False" Click="ProjectCancelTranslation_OnClick" />
                  </Grid>
                </Grid>
              </Border>

              <!-- Full editor workspace: white shell, native MPV, grouped multi-track subtitle timeline. -->
              <Border x:Name="ProjectWorkspaceView" IsVisible="False" Padding="0" MinHeight="520"
                      Background="#FFFFFF" BorderThickness="0" CornerRadius="0"
                      ClipToBounds="True" DragDrop.AllowDrop="True"
                      DragDrop.DragOver="Workspace_OnDragOver" DragDrop.Drop="Workspace_OnDrop">
                <Grid>
                  <Grid x:Name="WorkspaceRootGrid" ClipToBounds="True">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid x:Name="WorkspaceMiddleGrid" Grid.Row="0" ClipToBounds="True" MinHeight="160">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.45*" MinWidth="220" />
                      <ColumnDefinition Width="4" />
                      <ColumnDefinition Width="1*" MinWidth="240" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="WorkspaceVideoColumn" Grid.Column="0" RowDefinitions="*,44" Background="#050608" MinWidth="220" ClipToBounds="True">
                      <Grid Grid.Row="0" Background="#050608" ClipToBounds="True">
                        <local:MpvVideoHost x:Name="WorkspaceVideoHost" />
                        <Border x:Name="WorkspaceSplitPreviewOverlay" ZIndex="20" IsVisible="False"
                                IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                MaxWidth="720" Margin="24,0,24,24" Padding="16,8" CornerRadius="10"
                                Background="#CC101419" BorderBrush="#55FFFFFF" BorderThickness="1">
                          <TextBlock x:Name="WorkspaceSplitPreviewText" Text="" Foreground="#FFFFFF"
                                     FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <StackPanel x:Name="WorkspaceAudioOnlyPlaceholder" IsVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                          <Border Width="58" Height="58" CornerRadius="18" Background="#182432">
                            <icons:MaterialIcon Kind="Waveform" Width="30" Height="30" Foreground="#55AEF7"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="纯音频媒体" Foreground="#F1F4F7" FontSize="14" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" />
                          <TextBlock Text="可以播放、定位并编辑字幕时间轴" Foreground="#98A6B5" FontSize="10.5"
                                     HorizontalAlignment="Center" />
                          <Border Margin="0,12,0,0" MinWidth="320" MaxWidth="640" MinHeight="74"
                                  Padding="18,12" CornerRadius="12" Background="#141A22"
                                  BorderBrush="#263343" BorderThickness="1">
                            <StackPanel Spacing="7">
                              <TextBlock Text="字幕预览" Foreground="#66788A" FontSize="9.5"
                                         HorizontalAlignment="Center" />
                              <StackPanel x:Name="WorkspaceAudioSubtitlePreviewItems" Spacing="3">
                                <TextBlock Text="字幕将在播放时显示" Foreground="#718090" FontSize="14"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Grid>
                      <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1E5EA" BorderThickness="0,1,0,0">
                        <Grid Margin="12,0">
                          <TextBlock x:Name="WorkspaceCurrentTimeText" Text="00:00.000" Foreground="#242A31" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" />
                          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button Width="30" Height="30" Padding="0" Background="Transparent" Foreground="#59636F" BorderThickness="0" Click="WorkspaceBack_OnClick" ToolTip.Tip="后退 2 秒"><icons:MaterialIcon Kind="Rewind10" Width="17" Height="17" /></Button>
                            <Button Width="34" Height="34" Padding="0" CornerRadius="17" Background="#3399F3" Foreground="White" BorderThickness="0" Click="WorkspacePlayPause_OnClick"><icons:MaterialIcon x:Name="WorkspacePlayIcon" Kind="Play" Width="18" Height="18" /></Button>
                            <Button Width="30" Height="30" Padding="0" Background="Transparent" Foreground="#59636F" BorderThickness="0" Click="WorkspaceForward_OnClick" ToolTip.Tip="前进 2 秒"><icons:MaterialIcon Kind="FastForward10" Width="17" Height="17" /></Button>
                            <Button x:Name="WorkspaceSplitCueButton" Width="30" Height="30" Padding="0" Background="Transparent" Foreground="#59636F" BorderThickness="0" Click="WorkspaceSplitCue_OnClick" ToolTip.Tip="剪刀模式：C 进入，V 退出"><icons:MaterialIcon Kind="ContentCut" Width="17" Height="17" /></Button>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="WorkspacePlaybackStateText" Text="已暂停" Foreground="#6F7883" FontSize="10" />
                            <TextBlock Text="/" Foreground="#C0C5CC" FontSize="10" />
                            <TextBlock x:Name="WorkspaceDurationText" Text="00:00.000" Foreground="#6F7883" FontFamily="Consolas" FontSize="10" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Grid>

                    <GridSplitter x:Name="WorkspaceColumnSplitter" Grid.Column="1" Width="4"
                                  Classes="workspaceSplitter" ResizeDirection="Columns"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                  DoubleTapped="WorkspaceColumnSplitter_OnDoubleTapped"
                                  ToolTip.Tip="拖动调节视频宽度（双击自动贴合最佳比例）" />

                      <Border x:Name="WorkspaceStylePanel" Grid.Column="2" Background="#FFFFFF" BorderThickness="0" MinWidth="240" ClipToBounds="True">
                      <Grid RowDefinitions="42,*,42">
                        <Border BorderBrush="#E1E5EA" BorderThickness="0,0,0,1">
                          <Grid Margin="14,0,10,0" ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <TextBlock x:Name="WorkspaceRightPanelTitle" Text="字幕列表" Foreground="#252B33" FontWeight="Bold" FontSize="12" />
                              <TextBlock x:Name="WorkspaceRightPanelCount" Text="0 条" Foreground="#86909C" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Right Header Controls in List View (Track Capsule) -->
                            <StackPanel x:Name="WorkspaceListHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" IsVisible="True">
                              <!-- Track Filter Dropdown Capsule -->
                              <ComboBox x:Name="WorkspaceListTrackFilterCombo" Classes="workspaceTrackCombo"
                                        Height="28" MinWidth="92" FontSize="11" FontWeight="SemiBold"
                                        HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                        SelectionChanged="WorkspaceListTrackFilterCombo_OnChanged">
                                <ComboBoxItem Tag="-1" Content="全部轨道" />
                                <ComboBoxItem Tag="0" Content="L1 轨道" />
                                <ComboBoxItem Tag="1" Content="L2 轨道" />
                              </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="WorkspaceStyleHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                        VerticalAlignment="Center" IsVisible="False">
                              <Button Width="28" Height="28" Padding="0" CornerRadius="14" Background="#F2F4F6"
                                      Click="WorkspaceAddStyle_OnClick" ToolTip.Tip="新增样式">
                                <icons:MaterialIcon Kind="Plus" Width="15" Height="15" />
                              </Button>
                              <Button Width="28" Height="28" Padding="0" CornerRadius="14" Background="#F2F4F6"
                                      Click="WorkspaceCopyStyle_OnClick" ToolTip.Tip="复制当前样式">
                                <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                              </Button>
                            </StackPanel>

                          </Grid>
                        </Border>

                        <!-- Subtitle Style Card View -->
                        <Grid x:Name="WorkspaceStyleCardView" Grid.Row="1" Margin="7,7,7,8" IsVisible="False">
                          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <UniformGrid x:Name="WorkspaceStyleItemsPanel" Columns="3" Rows="0" />
                          </ScrollViewer>
                        </Grid>

                        <!-- Subtitle List Card View (Default View, Editable, with Floating Search & Replace Overlay) -->
                        <Grid x:Name="WorkspaceListCardView" Grid.Row="1" IsVisible="True" Margin="6,6,6,6">
                          <!-- ListBox fills the card space -->
                          <ListBox x:Name="WorkspaceSubtitleListBox"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   Padding="2,2,8,2"
                                   SelectionMode="Multiple"
                                   ItemContainerTheme="{StaticResource AstraSubtitleListItemTheme}"
                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                                   SelectionChanged="WorkspaceSubtitleList_OnSelectionChanged">
                            <ListBox.ItemsPanel>
                              <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                              </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                              <DataTemplate x:DataType="local:EditorSubtitleCue">
                                <Grid ColumnDefinitions="14,62,Auto,*,Auto,Auto" Background="Transparent" Margin="7,5,6,5" MinHeight="38"
                                      DoubleTapped="WorkspaceCueItem_OnDoubleTapped">
                                  <!-- Persistent track rail: inset and quiet at rest, stronger for the active cue. -->
                                  <Border Grid.Column="0" Width="{Binding IndicatorWidth}" CornerRadius="2"
                                          Background="{Binding IndicatorColor}" Opacity="{Binding IndicatorOpacity}"
                                          VerticalAlignment="Stretch" Margin="0,4,0,4" HorizontalAlignment="Left">
                                    <Border.Transitions>
                                      <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                                        <DoubleTransition Property="Width" Duration="0:0:0.14" />
                                      </Transitions>
                                    </Border.Transitions>
                                  </Border>

                                  <!-- Left Column: Timestamp & Duration (High space efficiency) -->
                                  <TextBlock Grid.Column="1" Text="{Binding StartLabel}" FontFamily="Consolas, monospace"
                                             FontSize="9.5" FontWeight="Bold" Foreground="{Binding TimeForeground}"
                                             VerticalAlignment="Center" Margin="0,0,7,0" />

                                  <Border Grid.Column="2" Height="20" MinWidth="34" Padding="7,0" CornerRadius="10"
                                          Background="{Binding LanguageBackground}" Opacity="{Binding LanguageOpacity}"
                                          VerticalAlignment="Center" Margin="0,0,9,0">
                                    <TextBlock Text="{Binding LanguageLabel}" FontSize="9" FontWeight="Bold"
                                               Foreground="{Binding LanguageForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Border>

                                  <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <local:HighlightTextBlock Text="{Binding DisplayText}"
                                                              HighlightText="{Binding #WorkspaceSubtitleSearchBox.Text}"
                                                              ReplaceText="{Binding #WorkspaceSubtitleReplaceBox.Text}"
                                                              IsReplaceActive="{Binding #WorkspaceSubtitleReplaceRow.IsVisible}"
                                                              HighlightBackground="#BAE6FD" HighlightForeground="#0369A1"
                                                              FontSize="{Binding DisplayFontSize}" FontWeight="{Binding DisplayFontWeight}"
                                                              Foreground="{Binding DisplayForeground}" VerticalAlignment="Center"
                                                              MaxLines="1" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                              IsVisible="{Binding !IsEditing}" />
                                    <TextBox Classes="workspaceEditorBox" Text="{Binding Translated, Mode=TwoWay}"
                                             Height="32" FontSize="12" Foreground="#17212B" Background="#FFFFFF"
                                             BorderBrush="#8BC8F5" BorderThickness="1.2" CornerRadius="6" Padding="8,0"
                                             VerticalContentAlignment="Center" TextWrapping="NoWrap" PlaceholderText="L1 轨道字幕…"
                                             LostFocus="WorkspaceCueListItem_OnLostFocus" KeyDown="WorkspaceCueListItem_OnKeyDown"
                                             IsVisible="{Binding ShowTranslatedEditor}" />
                                    <TextBox Classes="workspaceEditorBox" Text="{Binding Original, Mode=TwoWay}"
                                             Height="32" FontSize="11.5" Foreground="#536171" Background="#FFFFFF"
                                             BorderBrush="#CDBEF2" BorderThickness="1.2" CornerRadius="6" Padding="8,0"
                                             VerticalContentAlignment="Center" TextWrapping="NoWrap" PlaceholderText="L2 轨道字幕…"
                                             LostFocus="WorkspaceCueListItem_OnLostFocus" KeyDown="WorkspaceCueListItem_OnKeyDown"
                                             IsVisible="{Binding ShowOriginalEditor}" />
                                  </Grid>

                                  <Border Grid.Column="4" Height="20" Padding="7,0" CornerRadius="10" Background="#F2F4F6"
                                          VerticalAlignment="Center" Margin="0,0,5,0">
                                    <TextBlock Text="{Binding DurationLabel}" FontFamily="Consolas, monospace" FontSize="8.5"
                                               Foreground="#7B8794" VerticalAlignment="Center" />
                                  </Border>

                                  <Grid Grid.Column="5" VerticalAlignment="Center">
                                    <Button Width="24" Height="24" Padding="0" CornerRadius="12"
                                            Background="Transparent" Foreground="#8B97A5" BorderThickness="0"
                                            Click="WorkspaceCueEditBtn_OnClick" ToolTip.Tip="编辑字幕"
                                            IsVisible="{Binding !IsEditing}">
                                      <icons:MaterialIcon Kind="PencilOutline" Width="13" Height="13" />
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding IsEditing}">
                                      <Button Width="24" Height="24" Padding="0" CornerRadius="12" Background="#E7F3FD"
                                              Foreground="#167BCB" BorderThickness="0" Click="WorkspaceCueDoneEditing_OnClick" ToolTip.Tip="保存">
                                        <icons:MaterialIcon Kind="Check" Width="13" Height="13" />
                                      </Button>
                                      <Button Width="24" Height="24" Padding="0" CornerRadius="12" Background="#F2F4F6"
                                              Foreground="#66727F" BorderThickness="0" Click="WorkspaceCueCancelEditing_OnClick" ToolTip.Tip="取消">
                                        <icons:MaterialIcon Kind="Close" Width="13" Height="13" />
                                      </Button>
                                    </StackPanel>
                                  </Grid>
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>

                          <StackPanel x:Name="WorkspaceSubtitleListEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" Spacing="6">
                            <icons:MaterialIcon Kind="TextBoxOutline" Width="28" Height="28" Foreground="#B0B6C0" HorizontalAlignment="Center" />
                            <TextBlock Text="暂无字幕内容" FontSize="11" Foreground="#8B95A2" HorizontalAlignment="Center" />
                          </StackPanel>
                        </Grid>

                        <!-- Bottom Tab Switcher Dock (Clean, No Outer Box, Light-Blue Underline Indicator) -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E8EC" BorderThickness="0,1,0,0" Height="38">
                          <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Tab 1: Subtitle List (First) -->
                            <Button x:Name="WorkspaceViewListTabButton" Height="32" Padding="8,4,8,2"
                                    Background="Transparent" BorderThickness="0"
                                    Click="WorkspaceViewTab_OnClick" Tag="list" ToolTip.Tip="切换至字幕列表卡片">
                              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <icons:MaterialIcon x:Name="WorkspaceViewListTabIcon" Kind="FormatListBulleted" Width="16" Height="16" Foreground="#0089FF" HorizontalAlignment="Center" />
                                <Border x:Name="WorkspaceViewListTabIndicator" Width="18" Height="2.5" CornerRadius="1.5" Background="#0089FF" />
                              </StackPanel>
                            </Button>

                            <!-- Tab 2: Subtitle Style (Second) -->
                            <Button x:Name="WorkspaceViewStyleTabButton" Height="32" Padding="8,4,8,2"
                                    Background="Transparent" BorderThickness="0"
                                    Click="WorkspaceViewTab_OnClick" Tag="style" ToolTip.Tip="切换至字幕样式卡片">
                              <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <icons:MaterialIcon x:Name="WorkspaceViewStyleTabIcon" Kind="PaletteOutline" Width="16" Height="16" Foreground="#8C97A4" HorizontalAlignment="Center" />
                                <Border x:Name="WorkspaceViewStyleTabIndicator" Width="18" Height="2.5" CornerRadius="1.5" Background="Transparent" />
                              </StackPanel>
                            </Button>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                  </Grid>

                  <GridSplitter x:Name="WorkspaceTimelineSplitter" Grid.Row="1" Height="4"
                                Classes="workspaceSplitter" ResizeDirection="Rows"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                PointerPressed="WorkspaceTimelineSplitter_OnPointerPressed"
                                DoubleTapped="WorkspaceTimelineSplitter_OnDoubleTapped"
                                ToolTip.Tip="拖动调节时间轴高度（双击恢复默认高度）" />

                  <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E1E5EA" BorderThickness="0,1,0,0" ClipToBounds="True">
                    <Grid RowDefinitions="34,*,26" x:Name="WorkspaceTimelineArea" Background="#FFFFFF" ClipToBounds="True">
                    <Grid Margin="10,0">
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Width="28" Height="28" Padding="0" Background="Transparent" Foreground="#59636F"
                                BorderThickness="0" Click="WorkspaceExit_OnClick" ToolTip.Tip="返回进入工作区前的位置">
                          <icons:MaterialIcon x:Name="WorkspaceSidebarIcon" Kind="ArrowLeft" Width="17" Height="17" />
                        </Button>
                        <Button Width="28" Height="28" Padding="0" Background="Transparent" Foreground="#59636F"
                                BorderThickness="0" Click="WorkspaceOpenMedia_OnClick" ToolTip.Tip="更换媒体">
                          <icons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                        </Button>
                        <Button x:Name="WorkspaceUndoAction" Width="28" Height="28" Padding="0" Background="Transparent"
                                Foreground="#59636F" BorderThickness="0" IsEnabled="False"
                                Click="WorkspaceUndo_OnClick" ToolTip.Tip="撤销时间轴修改">
                          <icons:MaterialIcon Kind="Undo" Width="16" Height="16" />
                        </Button>
                        <Button x:Name="WorkspaceRedoAction" Width="28" Height="28" Padding="0" Background="Transparent"
                                Foreground="#59636F" BorderThickness="0" IsEnabled="False"
                                Click="WorkspaceRedo_OnClick" ToolTip.Tip="重做时间轴修改">
                          <icons:MaterialIcon Kind="Redo" Width="16" Height="16" />
                        </Button>
                        <TextBlock x:Name="WorkspaceMediaNameText" Text="尚未导入媒体" Foreground="#252B33" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Search Icon Button -->
                        <Button x:Name="WorkspaceSubtitleSearchToggleBtn" Width="26" Height="26" Padding="0" CornerRadius="13"
                                Background="#F0F2F4" Foreground="#55606E" BorderThickness="0"
                                Click="WorkspaceSubtitleSearchToggle_OnClick" ToolTip.Tip="查找字幕 (Ctrl+F)">
                          <icons:MaterialIcon Kind="Magnify" Width="15" Height="15" />
                        </Button>

                        <!-- Replace Icon Button -->
                        <Button x:Name="WorkspaceSubtitleReplaceToggleBtn" Width="26" Height="26" Padding="0" CornerRadius="13"
                                Background="#F0F2F4" Foreground="#55606E" BorderThickness="0"
                                Click="WorkspaceSubtitleReplaceToggle_OnClick" ToolTip.Tip="查找与替换 (Ctrl+H)">
                          <icons:MaterialIcon Kind="FindReplace" Width="15" Height="15" />
                        </Button>

                        <Border Width="1" Height="14" Background="#E2E6EA" Margin="2,0" />

                        <Button x:Name="WorkspaceToggleWaveformButton" Width="26" Height="26" Padding="0" Background="Transparent"
                                Foreground="#59636F" BorderThickness="0" Click="WorkspaceToggleWaveform_OnClick" ToolTip.Tip="显示 / 隐藏音频波形">
                          <icons:MaterialIcon x:Name="WorkspaceWaveformEyeIcon" Kind="EyeOutline" Width="16" Height="16" />
                        </Button>
                        <TextBlock x:Name="WorkspaceWaveformStateText" Text="等待生成波形" Foreground="#7D8792" FontSize="9.5" VerticalAlignment="Center" />
                        <TextBlock x:Name="WorkspaceSaveStateText" Text="" Foreground="#4FAE83" FontSize="10"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        <Button Width="28" Height="28" Padding="0" Background="Transparent" Foreground="#59636F"
                                BorderThickness="0" Click="WorkspaceFullscreen_OnClick" ToolTip.Tip="全屏工作区">
                          <icons:MaterialIcon x:Name="WorkspaceFullscreenIcon" Kind="Fullscreen" Width="17" Height="17" />
                        </Button>
                      </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" ClipToBounds="True">
                      <local:SubtitleTimelineControl x:Name="WorkspaceTimeline" VerticalAlignment="Stretch" />
                      <Canvas x:Name="WorkspaceCueEditorLayer" IsHitTestVisible="True">
                        <!-- Inline editor anchored below the selected subtitle block. -->
                        <Border x:Name="WorkspaceCueInlineEditor" Width="520" Height="58" IsVisible="False"
                                Background="#F1F3F5" BorderBrush="#C9D0D8" BorderThickness="1" CornerRadius="16"
                                BoxShadow="0 7 18 0 #260C1D2C">
                          <Grid Margin="9,8" ColumnDefinitions="*,52,36,7,36">
                            <TextBox x:Name="WorkspaceCueEditTextBox" Classes="workspaceEditorBox" Grid.Column="0" Height="36" Padding="10,0"
                                     VerticalContentAlignment="Center" AcceptsReturn="False"
                                     Background="#FFFFFF" Foreground="#20252C" BorderBrush="#0089FF"
                                     BorderThickness="1.5" CornerRadius="0" FontSize="12.5"
                                     TextChanged="WorkspaceCueEditText_OnTextChanged"
                                     KeyDown="WorkspaceCueEditText_OnKeyDown" />
                            <TextBlock x:Name="WorkspaceCueEditCountText" Grid.Column="1" Text="0" FontFamily="Consolas"
                                       Foreground="#6E7782" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Width="34" Height="34" Padding="0" CornerRadius="17"
                                    Background="#DDE2E7" Foreground="#52606C" BorderThickness="0"
                                    Click="WorkspaceCueEditConfirm_OnClick" ToolTip.Tip="完成编辑（Enter）">
                              <icons:MaterialIcon Kind="Check" Width="17" Height="17" />
                            </Button>
                            <Button Grid.Column="4" Width="34" Height="34" Padding="0" CornerRadius="17"
                                    Background="#DDE2E7" Foreground="#65707B" BorderThickness="0"
                                    Click="WorkspaceCueEditCancel_OnClick" ToolTip.Tip="取消（Esc）">
                              <icons:MaterialIcon Kind="Close" Width="17" Height="17" />
                            </Button>
                          </Grid>
                        </Border>
                      </Canvas>
                    </Grid>

                    <!-- Floating Search & Replace Overlay Card (Anchored below Search/Replace buttons in Timeline area) -->
                    <Border x:Name="WorkspaceSubtitleSearchReplacePanel"
                            Grid.Row="0" Grid.RowSpan="2"
                            VerticalAlignment="Top" HorizontalAlignment="Right"
                            Width="310"
                            Margin="0,32,10,0" Padding="7,6" CornerRadius="10"
                            Background="#FFFFFF" BorderBrush="#DCE2EA" BorderThickness="1"
                            BoxShadow="0 6 18 0 #24000000"
                            ZIndex="300" Opacity="0" IsHitTestVisible="False" IsVisible="False"
                            RenderTransformOrigin="85%,0%"
                            RenderTransform="translateY(-8px) scale(0.96)">
                      <Border.Transitions>
                        <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                        </Transitions>
                      </Border.Transitions>
                      <StackPanel Spacing="5">
                        <!-- Search Row with Up/Down Jump Arrows -->
                        <Grid x:Name="WorkspaceSubtitleSearchRow" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                          <TextBox x:Name="WorkspaceSubtitleSearchBox"
                                   Classes="workspaceCapsuleSearch"
                                   PlaceholderText="查找字幕内容..."
                                   KeyDown="WorkspaceSubtitleSearchBox_OnKeyDown"
                                   TextChanged="WorkspaceSubtitleSearch_OnTextChanged" />
                          <TextBlock x:Name="WorkspaceSubtitleMatchCountText" Grid.Column="1" Margin="5,0,2,0"
                                     VerticalAlignment="Center" FontSize="9.5" Foreground="#6C7684" Text="0 / 0" />
                          <Button x:Name="WorkspaceSubtitlePrevMatchBtn" Grid.Column="2" Width="22" Height="22" Padding="0"
                                  CornerRadius="4" Background="Transparent" Foreground="#475569" BorderThickness="0"
                                  Click="WorkspaceSubtitlePrevMatch_OnClick" ToolTip.Tip="上一处 (Shift+Enter)">
                            <icons:MaterialIcon Kind="ChevronUp" Width="15" Height="15" />
                          </Button>
                          <Button x:Name="WorkspaceSubtitleNextMatchBtn" Grid.Column="3" Width="22" Height="22" Padding="0"
                                  CornerRadius="4" Background="Transparent" Foreground="#475569" BorderThickness="0"
                                  Click="WorkspaceSubtitleNextMatch_OnClick" ToolTip.Tip="下一处 (Enter)">
                            <icons:MaterialIcon Kind="ChevronDown" Width="15" Height="15" />
                          </Button>
                          <Button x:Name="WorkspaceSubtitleCloseSearchBtn" Grid.Column="4" Margin="2,0,0,0" Width="20" Height="20" Padding="0"
                                  CornerRadius="10" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                  Click="WorkspaceSubtitleCloseSearch_OnClick" ToolTip.Tip="关闭查找 (Esc)">
                            <icons:MaterialIcon Kind="Close" Width="12" Height="12" />
                          </Button>
                        </Grid>

                        <!-- Replace Row with Check & Close Buttons -->
                        <Grid x:Name="WorkspaceSubtitleReplaceRow" ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="False">
                          <TextBox x:Name="WorkspaceSubtitleReplaceBox"
                                   Classes="workspaceCapsuleSearch"
                                   PlaceholderText="替换为..."
                                   KeyDown="WorkspaceSubtitleReplaceBox_OnKeyDown"
                                   TextChanged="WorkspaceSubtitleSearch_OnTextChanged" />
                          <Button x:Name="WorkspaceSubtitleReplaceOneBtn" Grid.Column="1" Margin="4,0,0,0" Width="24" Height="24" Padding="0"
                                  CornerRadius="12" Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0"
                                  Click="WorkspaceSubtitleReplaceOne_OnClick" ToolTip.Tip="替换当前项 (Enter)">
                            <icons:MaterialIcon Kind="Check" Width="14" Height="14" />
                          </Button>
                          <Button x:Name="WorkspaceSubtitleReplaceAllBtn" Grid.Column="2" Margin="3,0,0,0" Width="24" Height="24" Padding="0"
                                  CornerRadius="12" Background="#3399F3" Foreground="#FFFFFF" BorderThickness="0"
                                  Click="WorkspaceSubtitleReplaceAll_OnClick" ToolTip.Tip="全部替换">
                            <icons:MaterialIcon Kind="CheckAll" Width="14" Height="14" />
                          </Button>
                          <Button x:Name="WorkspaceSubtitleReplaceCloseBtn" Grid.Column="3" Margin="2,0,0,0" Width="20" Height="20" Padding="0"
                                  CornerRadius="10" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                  Click="WorkspaceSubtitleCloseSearch_OnClick" ToolTip.Tip="关闭 (Esc)">
                            <icons:MaterialIcon Kind="Close" Width="12" Height="12" />
                          </Button>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <ScrollBar x:Name="WorkspaceTimelineScrollBar" Grid.Row="2" Orientation="Horizontal"
                               Minimum="0" Maximum="0" ViewportSize="1" SmallChange="1" LargeChange="10"
                               Height="20" Margin="12,0" VerticalAlignment="Center"
                               Scroll="WorkspaceTimelineScrollBar_OnScroll">
                      <ScrollBar.Styles>
                        <Style Selector="ScrollBar Thumb">
                          <Setter Property="Background" Value="#9AB8D4" />
                          <Setter Property="CornerRadius" Value="5" />
                          <Setter Property="MinWidth" Value="56" />
                        </Style>
                        <Style Selector="ScrollBar Thumb:pointerover">
                          <Setter Property="Background" Value="#5F97C4" />
                        </Style>
                        <Style Selector="ScrollBar:horizontal /template/ Track#PART_Track">
                          <Setter Property="MinHeight" Value="20" />
                        </Style>
                      </ScrollBar.Styles>
                    </ScrollBar>
                  </Grid>
                  </Border>
                </Grid>
                  <!-- Reusable four-tile loading overlay for workspace preparation. -->
                  <Border x:Name="WorkspaceLoadingOverlay" ZIndex="30" IsVisible="False" IsHitTestVisible="True"
                          Background="#FFFFFF" Opacity="0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                      <Grid Width="26" Height="26" HorizontalAlignment="Center"
                            RowDefinitions="11,4,11" ColumnDefinitions="11,4,11">
                        <Border x:Name="WorkspaceLoadingTileTopLeft" Grid.Row="0" Grid.Column="0"
                                Background="#747982" CornerRadius="4,1.5,1.5,1.5" />
                        <Border x:Name="WorkspaceLoadingTileTopRight" Grid.Row="0" Grid.Column="2"
                                Background="#747982" CornerRadius="1.5,4,1.5,1.5" />
                        <Border x:Name="WorkspaceLoadingTileBottomLeft" Grid.Row="2" Grid.Column="0"
                                Background="#747982" CornerRadius="1.5,1.5,1.5,4" />
                        <Border x:Name="WorkspaceLoadingTileBottomRight" Grid.Row="2" Grid.Column="2"
                                Background="#747982" CornerRadius="1.5,1.5,4,1.5" />
                      </Grid>
                      <TextBlock x:Name="WorkspaceLoadingText" Text="正在加载工作区…"
                                 FontSize="12" FontWeight="SemiBold" Foreground="#5F6875"
                                 HorizontalAlignment="Center" />
                      <TextBlock Text="正在准备时间轴、字幕数据与媒体播放器" FontSize="10.5" Foreground="#A0A6AF"
                                 HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              </Grid>
            </Grid>
          </Grid>

          <!-- Model installation and runtime configuration page. -->
          <Grid x:Name="ModelsPage" IsVisible="False" Background="#F7F7F8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,34,36,42" MaxWidth="1060">
              <Grid x:Name="ModelsPageHeader" ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="模型配置" Classes="pageTitle" />
                  <TextBlock Text="下载本地模型并调整识别参数" Foreground="#7E8794" FontSize="13" Margin="0,7,0,0" />
                </StackPanel>
                <Grid Grid.Column="1" Width="230" Height="42">
                  <Grid ColumnDefinitions="96,134">
                    <Button x:Name="ModelDownloadTab" Classes="modelTab selected" Tag="download" Click="ModelTab_OnClick" Content="模型下载" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button x:Name="ModelSettingsTab" Grid.Column="1" Classes="modelTab" Tag="settings" Click="ModelTab_OnClick" Content="默认参数配置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </Grid>
                  <Border x:Name="ModelTabIndicator" Width="52" Height="3" Margin="22,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="2" Background="#3399F3" IsHitTestVisible="False">
                    <Border.Transitions>
                      <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                        <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
                      </Transitions>
                    </Border.Transitions>
                  </Border>
                </Grid>
              </Grid>

              <Grid x:Name="ModelDownloadHost">
              <StackPanel x:Name="ModelDownloadView">
              <Grid Margin="0,22,0,0" ColumnDefinitions="*,Auto"><TextBlock Text="可用模型" Classes="sectionTitle" /><TextBlock x:Name="DeploymentSummaryText" Grid.Column="1" Text="正在检查本地组件" Foreground="#7E8794" FontSize="11" VerticalAlignment="Center" /></Grid>

              <Border Classes="deploymentCard motion-item" Margin="0,15,0,0" Padding="15,12,16,14">
                <StackPanel>
                  <TextBlock Text="推荐" Classes="deploymentCardTitle" Margin="0,0,0,8" />
                  <Border Classes="deploymentModelRow" Tag="nvidia-parakeet-v3" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand">
                    <Grid ColumnDefinitions="48,*,Auto">
                      <Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/nvidia.png" Stretch="Uniform" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="NVIDIA Parakeet TDT 0.6B V3" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="RecommendedNvidiaMetadataText" Text="25 种语言 · 高吞吐与词级时间戳" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel>
                      <Button x:Name="RecommendedNvidiaText" Grid.Column="2" Classes="modelStateAction" Tag="nvidia-parakeet-v3" IsHitTestVisible="False">下载</Button>
                    </Grid>
                  </Border>
                  <Border Classes="deploymentModelRow" Tag="qwen-0.6b" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand">
                    <Grid ColumnDefinitions="48,*,Auto">
                      <Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/qwen-hf.jpeg" Stretch="UniformToFill" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Qwen3-ASR 0.6B" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="RecommendedQwenMetadataText" Text="中文与方言 · 轻量高质量" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel>
                      <Button x:Name="RecommendedQwenText" Grid.Column="2" Classes="modelStateAction" Tag="qwen-0.6b" IsHitTestVisible="False">下载</Button>
                    </Grid>
                  </Border>
                  <Border Classes="deploymentModelRow" Tag="whisper-v3-turbo" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand">
                    <Grid ColumnDefinitions="48,*,Auto">
                      <Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/openai.png" Stretch="Uniform" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Whisper Large V3 Turbo" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="RecommendedWhisperMetadataText" Text="99 种语言 · Large V3 的高速精简版" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel>
                      <Button x:Name="RecommendedWhisperText" Grid.Column="2" Classes="modelStateAction" Tag="whisper-v3-turbo" IsHitTestVisible="False">下载</Button>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <Border Classes="deploymentCard motion-item" Margin="0,15,0,0"><StackPanel><Border Classes="deploymentCardHeader" Tag="whisper" PointerReleased="DeploymentGroup_OnPointerReleased"><Grid ColumnDefinitions="*,Auto,16"><TextBlock Text="OpenAI Whisper (6)" Classes="deploymentCardTitle" VerticalAlignment="Center" /><TextBlock x:Name="WhisperGroupSummary" Grid.Column="1" Text="未安装" Foreground="#89919D" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" /><icons:MaterialIcon x:Name="WhisperChevron" Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" Foreground="#3F4651" /></Grid></Border><Border x:Name="WhisperGroupPanel" MaxHeight="0" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True"><StackPanel x:Name="WhisperModelRows" Height="348" VerticalAlignment="Top">
                <Border x:Name="WhisperTinyRow" Classes="deploymentModelRow" Tag="whisper-tiny" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/openai.png" Stretch="Uniform" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Tiny" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="WhisperTinyMetadataText" Text="75 MB · 99 种语言 · 最快" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="WhisperTinyBadge" IsVisible="False"><TextBlock x:Name="WhisperTinyStatus" /></Border><Button x:Name="WhisperTinyAction" Grid.Column="2" Classes="modelStateAction" Tag="whisper-tiny" IsHitTestVisible="False">下载</Button></Grid></Border>
                <Border x:Name="WhisperBaseRow" Classes="deploymentModelRow" Tag="whisper-base" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/openai.png" Stretch="Uniform" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Base" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="WhisperBaseMetadataText" Text="145 MB · 速度与精度入门平衡" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="WhisperBaseBadge" IsVisible="False"><TextBlock x:Name="WhisperBaseStatus" /></Border><Button x:Name="WhisperBaseAction" Grid.Column="2" Classes="modelStateAction" Tag="whisper-base" IsHitTestVisible="False">下载</Button></Grid></Border>
                <Border x:Name="WhisperSmallRow" Classes="deploymentModelRow" Tag="whisper-small" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/openai.png" Stretch="Uniform" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Small" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="WhisperSmallMetadataText" Text="464 MB · 均衡 · 分段时间戳" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="WhisperSmallBadge" IsVisible="False"><TextBlock x:Name="WhisperSmallStatus" /></Border><Button x:Name="WhisperSmallAction" Grid.Column="2" Classes="modelStateAction" Tag="whisper-small" IsHitTestVisible="False">下载</Button></Grid></Border>
                <Border x:Name="WhisperMediumRow" Classes="deploymentModelRow" Tag="whisper-medium" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/openai.png" Stretch="Uniform" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Medium" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="WhisperMediumMetadataText" Text="1.53 GB · 高精度 · 中等显存占用" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="WhisperMediumBadge" IsVisible="False"><TextBlock x:Name="WhisperMediumStatus" /></Border><Button x:Name="WhisperMediumAction" Grid.Column="2" Classes="modelStateAction" Tag="whisper-medium" IsHitTestVisible="False">下载</Button></Grid></Border>
                <Border x:Name="WhisperLargeRow" Classes="deploymentModelRow" Tag="whisper-large-v3" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/openai.png" Stretch="Uniform" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Large V3" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="WhisperLargeMetadataText" Text="3.1 GB · 高精度 · 建议 6 GB 显存" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="WhisperLargeBadge" IsVisible="False"><TextBlock x:Name="WhisperLargeStatus" /></Border><Button x:Name="WhisperLargeAction" Grid.Column="2" Classes="modelStateAction" Tag="whisper-large-v3" IsHitTestVisible="False">下载</Button></Grid></Border>
                <Border x:Name="WhisperTurboRow" Classes="deploymentModelRow" Tag="whisper-v3-turbo" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/openai.png" Stretch="Uniform" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Large V3 Turbo" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="WhisperTurboMetadataText" Text="1.62 GB · 99 种语言 · 大幅提速" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="WhisperTurboBadge" IsVisible="False"><TextBlock x:Name="WhisperTurboStatus" /></Border><Button x:Name="WhisperTurboAction" Grid.Column="2" Classes="modelStateAction" Tag="whisper-v3-turbo" IsHitTestVisible="False">下载</Button></Grid></Border>
              </StackPanel></Border></StackPanel></Border>

              <Border Classes="deploymentCard motion-item" Margin="0,15,0,0"><StackPanel><Border Classes="deploymentCardHeader" Tag="qwen" PointerReleased="DeploymentGroup_OnPointerReleased"><Grid ColumnDefinitions="*,Auto,16"><TextBlock Text="Qwen3-ASR (2)" Classes="deploymentCardTitle" VerticalAlignment="Center" /><TextBlock x:Name="QwenGroupSummary" Grid.Column="1" Text="未安装" Foreground="#89919D" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" /><icons:MaterialIcon x:Name="QwenChevron" Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" Foreground="#3F4651" /></Grid></Border><Border x:Name="QwenGroupPanel" MaxHeight="0" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True"><StackPanel x:Name="QwenModelRows" Height="116" VerticalAlignment="Top">
                <Border x:Name="QwenSmallRow" Classes="deploymentModelRow" Tag="qwen-0.6b" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/qwen-hf.jpeg" Stretch="UniformToFill" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="0.6B" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="QwenSmallMetadataText" Text="1.8 GB · 30 种语言 + 22 种中文方言" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="QwenSmallBadge" IsVisible="False"><TextBlock x:Name="QwenSmallStatus" /></Border><Button x:Name="QwenSmallAction" Grid.Column="2" Classes="modelStateAction" Tag="qwen-0.6b" IsHitTestVisible="False">下载</Button></Grid></Border>
                <Border x:Name="QwenLargeRow" Classes="deploymentModelRow" Tag="qwen-1.7b" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/qwen-hf.jpeg" Stretch="UniformToFill" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="1.7B" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="QwenLargeMetadataText" Text="4.7 GB · 高精度 · 建议 8 GB 显存" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="QwenLargeBadge" IsVisible="False"><TextBlock x:Name="QwenLargeStatus" /></Border><Button x:Name="QwenLargeAction" Grid.Column="2" Classes="modelStateAction" Tag="qwen-1.7b" IsHitTestVisible="False">下载</Button></Grid></Border>
              </StackPanel></Border></StackPanel></Border>

              <Border Classes="deploymentCard motion-item" Margin="0,15,0,0"><StackPanel><Border Classes="deploymentCardHeader" Tag="funasr" PointerReleased="DeploymentGroup_OnPointerReleased"><Grid ColumnDefinitions="*,Auto,16"><TextBlock Text="FunASR (2)" Classes="deploymentCardTitle" VerticalAlignment="Center" /><TextBlock x:Name="FunAsrGroupSummary" Grid.Column="1" Text="未安装" Foreground="#89919D" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" /><icons:MaterialIcon x:Name="FunAsrChevron" Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" Foreground="#3F4651" /></Grid></Border><Border x:Name="FunAsrGroupPanel" MaxHeight="0" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True"><StackPanel x:Name="FunAsrModelRows" Height="116" VerticalAlignment="Top">
                <Border x:Name="FunAsrNanoRow" Classes="deploymentModelRow" Tag="funasr-nano" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/funasr.png" Stretch="Uniform" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Fun-ASR Nano 2512" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="FunAsrNanoMetadataText" Text="1.99 GB · 方言、热词、时间戳、实时识别" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="FunAsrNanoBadge" IsVisible="False"><TextBlock x:Name="FunAsrNanoStatus" /></Border><Button x:Name="FunAsrNanoAction" Grid.Column="2" Classes="modelStateAction" Tag="funasr-nano" IsHitTestVisible="False">下载</Button></Grid></Border>
                <Border x:Name="SenseVoiceRow" Classes="deploymentModelRow" Tag="sensevoice-small" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/funasr.png" Stretch="Uniform" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SenseVoice Small" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="SenseVoiceMetadataText" Text="944 MB · 低延迟 · 情绪与声音事件" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="SenseVoiceBadge" IsVisible="False"><TextBlock x:Name="SenseVoiceStatus" /></Border><Button x:Name="SenseVoiceAction" Grid.Column="2" Classes="modelStateAction" Tag="sensevoice-small" IsHitTestVisible="False">下载</Button></Grid></Border>
              </StackPanel></Border></StackPanel></Border>

              <Border Classes="deploymentCard motion-item" Margin="0,15,0,0"><StackPanel><Border Classes="deploymentCardHeader" Tag="nvidia" PointerReleased="DeploymentGroup_OnPointerReleased"><Grid ColumnDefinitions="*,Auto,16"><TextBlock Text="NVIDIA Speech (2)" Classes="deploymentCardTitle" VerticalAlignment="Center" /><TextBlock x:Name="NvidiaGroupSummary" Grid.Column="1" Text="未安装" Foreground="#89919D" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" /><icons:MaterialIcon x:Name="NvidiaChevron" Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" Foreground="#3F4651" /></Grid></Border><Border x:Name="NvidiaGroupPanel" MaxHeight="0" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True"><StackPanel x:Name="NvidiaModelRows" Height="116" VerticalAlignment="Top">
                <Border x:Name="NvidiaParakeetRow" Classes="deploymentModelRow" Tag="nvidia-parakeet-v3" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/nvidia.png" Stretch="Uniform" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Parakeet TDT 0.6B V3" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="NvidiaParakeetMetadataText" Text="2.6 GB · 25 种语言 · 高吞吐与时间戳" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="NvidiaParakeetBadge" IsVisible="False"><TextBlock x:Name="NvidiaParakeetStatus" /></Border><Button x:Name="NvidiaParakeetAction" Grid.Column="2" Classes="modelStateAction" Tag="nvidia-parakeet-v3" IsHitTestVisible="False">下载</Button></Grid></Border>
                <Border x:Name="NvidiaCanaryRow" Classes="deploymentModelRow" Tag="nvidia-canary-v2" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/nvidia.png" Stretch="Uniform" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Canary 1B V2" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="NvidiaCanaryMetadataText" Text="6.36 GB · 25 种语言 · 识别与语音翻译" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="NvidiaCanaryBadge" IsVisible="False"><TextBlock x:Name="NvidiaCanaryStatus" /></Border><Button x:Name="NvidiaCanaryAction" Grid.Column="2" Classes="modelStateAction" Tag="nvidia-canary-v2" IsHitTestVisible="False">下载</Button></Grid></Border>
              </StackPanel></Border></StackPanel></Border>

              <Border Classes="deploymentCard motion-item" Margin="0,15,0,0"><StackPanel><Border Classes="deploymentCardHeader" Tag="moss" PointerReleased="DeploymentGroup_OnPointerReleased"><Grid ColumnDefinitions="*,Auto,16"><TextBlock Text="MOSS Transcribe (1)" Classes="deploymentCardTitle" VerticalAlignment="Center" /><TextBlock x:Name="MossGroupSummary" Grid.Column="1" Text="未安装" Foreground="#89919D" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" /><icons:MaterialIcon x:Name="MossChevron" Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" Foreground="#3F4651" /></Grid></Border><Border x:Name="MossGroupPanel" MaxHeight="0" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True">
                <Border x:Name="MossRow" Classes="deploymentModelRow" Height="58" VerticalAlignment="Top" Tag="moss-0.9b" PointerReleased="ModelRow_OnPointerReleased" Cursor="Hand"><Grid ColumnDefinitions="48,*,Auto"><Image Width="36" Height="36" Source="avares://AstraCat/Assets/Models/moss.png" Stretch="Uniform" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Transcribe-Diarize 0.9B" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="MossMetadataText" Text="1.83 GB · 长音频 · 时间戳 · 说话人分离" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="MossBadge" IsVisible="False"><TextBlock x:Name="MossStatus" /></Border><Button x:Name="MossAction" Grid.Column="2" Classes="modelStateAction" Tag="moss-0.9b" IsHitTestVisible="False">下载</Button></Grid></Border>
              </Border></StackPanel></Border>

              <Border Classes="deploymentCard motion-item" Margin="0,15,0,0" IsVisible="False"><StackPanel><Border Classes="deploymentCardHeader" Tag="runtime" PointerReleased="DeploymentGroup_OnPointerReleased"><Grid ColumnDefinitions="*,Auto,16"><TextBlock Text="运行环境 (4)" Classes="deploymentCardTitle" VerticalAlignment="Center" /><TextBlock x:Name="RuntimeGroupSummary" Grid.Column="1" Text="检查中" Foreground="#89919D" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" /><icons:MaterialIcon x:Name="RuntimeChevron" Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" Foreground="#3F4651" /></Grid></Border><Border x:Name="RuntimeGroupPanel" MaxHeight="0" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True"><StackPanel Height="232" VerticalAlignment="Top">
                <Border Classes="deploymentModelRow"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Python 3.12" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="隔离基础环境" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="PythonRuntimeBadge" IsVisible="False"><TextBlock x:Name="PythonRuntimeStatus" /></Border><Button x:Name="PythonRuntimeAction" Grid.Column="1" Classes="modelStateAction" Tag="python-runtime" Click="DeploymentAction_OnClick">未下载</Button></Grid></Border>
                <Border Classes="deploymentModelRow"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Faster-Whisper / CTranslate2" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Whisper 推理环境" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="WhisperRuntimeBadge" IsVisible="False"><TextBlock x:Name="WhisperRuntimeStatus" /></Border><Button x:Name="WhisperRuntimeAction" Grid.Column="1" Classes="modelStateAction" Tag="whisper-runtime" Click="DeploymentAction_OnClick">未下载</Button></Grid></Border>
                <Border Classes="deploymentModelRow"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="PyTorch CUDA" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Qwen、FunASR、MOSS 共用环境" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="QwenRuntimeBadge" IsVisible="False"><TextBlock x:Name="QwenRuntimeStatus" /></Border><Button x:Name="QwenRuntimeAction" Grid.Column="1" Classes="modelStateAction" Tag="qwen-runtime" Click="DeploymentAction_OnClick">未下载</Button></Grid></Border>
                <Border Classes="deploymentModelRow"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="NVIDIA Transformers" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Parakeet、Canary 共用推理环境" Foreground="#89919D" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border x:Name="NvidiaRuntimeBadge" IsVisible="False"><TextBlock x:Name="NvidiaRuntimeStatus" /></Border><Button x:Name="NvidiaRuntimeAction" Grid.Column="1" Classes="modelStateAction" Tag="nvidia-runtime" Click="DeploymentAction_OnClick">未下载</Button></Grid></Border>
              </StackPanel></Border></StackPanel></Border>
              </StackPanel>

              <Grid x:Name="ModelDeploymentDetailView" IsVisible="False" Margin="0,8,0,0"
                    RowDefinitions="Auto,22,Auto,18,Auto,*,Auto,10,Auto" MinHeight="540"
                    MaxWidth="920" HorizontalAlignment="Stretch">
                <Border Classes="deploymentCard motion-item" Padding="18,14">
                  <Grid ColumnDefinitions="42,54,*">
                    <Button Classes="windowButton" Width="34" Height="34" Click="ModelDetailBack_OnClick" ToolTip.Tip="返回模型列表">
                      <icons:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" Foreground="#747A84" />
                    </Button>
                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="5" Background="White" VerticalAlignment="Center">
                      <Image x:Name="ModelDetailIcon" Stretch="Uniform" Margin="3" />
                    </Border>
                    <Border Grid.Column="2" Height="42" BorderBrush="Transparent" BorderThickness="0" CornerRadius="5" Padding="12,0">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock x:Name="ModelDetailTitle" FontSize="14" FontWeight="SemiBold" />
                          <TextBlock x:Name="ModelDetailSubtitle" Foreground="#89919D" FontSize="10.5" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ModelDetailMode" Grid.Column="1" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" FontWeight="SemiBold" />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="12">
                  <TextBlock Text="模型组件" Classes="sectionTitle" Margin="2,0,0,-3" />
                  <Border Classes="deploymentCard motion-item">
                    <StackPanel>
                      <Border Height="52" Padding="18,0" BorderBrush="#ECECF1" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,220">
                          <StackPanel VerticalAlignment="Center"><TextBlock Text="下载源" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="选择模型权重使用的镜像站点" Foreground="#A2A5AA" FontSize="10.5" Margin="0,2,0,0" /></StackPanel>
                          <ComboBox x:Name="ModelMirrorCombo" Grid.Column="1" Classes="settingSelect" SelectedIndex="0">
                            <ComboBoxItem Content="自动选择（推荐）" />
                            <ComboBoxItem Content="HF-Mirror（国内）" />
                            <ComboBoxItem Content="Hugging Face（官方）" />
                          </ComboBox>
                        </Grid>
                      </Border>
                      <Border Height="52" Padding="18,0" BorderBrush="#ECECF1" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="190,*,Auto,Auto">
                          <TextBlock Text="模型权重" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock x:Name="ModelWeightDescription" Grid.Column="1" Foreground="#A2A5AA" FontSize="11" VerticalAlignment="Center" />
                          <TextBlock x:Name="ModelWeightStatus" Grid.Column="2" IsVisible="False" />
                          <Button x:Name="ModelWeightUninstallAction" Grid.Column="3" Classes="componentInstallAction" Tag="model" Click="ModelComponentAction_OnClick" />
                        </Grid>
                      </Border>
                      <Border Height="52" Padding="18,0" BorderBrush="#ECECF1" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="190,*,Auto,Auto">
                          <TextBlock Text="Python 3.12" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="隔离基础环境" Foreground="#A2A5AA" FontSize="11" VerticalAlignment="Center" />
                          <TextBlock x:Name="ModelPythonStatus" Grid.Column="2" IsVisible="False" />
                          <Button x:Name="ModelPythonProtectedAction" Grid.Column="3" Classes="componentInstallAction" Tag="python" Click="ModelComponentAction_OnClick" />
                        </Grid>
                      </Border>
                      <Border Height="52" Padding="18,0">
                        <Grid ColumnDefinitions="190,*,Auto,Auto">
                          <TextBlock x:Name="ModelRuntimeTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock x:Name="ModelRuntimeDescription" Grid.Column="1" Foreground="#A2A5AA" FontSize="11" VerticalAlignment="Center" />
                          <TextBlock x:Name="ModelRuntimeStatus" Grid.Column="2" IsVisible="False" />
                          <Button x:Name="ModelRuntimeUninstallAction" Grid.Column="3" Classes="componentInstallAction" Tag="runtime" Click="ModelComponentAction_OnClick" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                  <Grid Margin="2,5,0,-3" ColumnDefinitions="*,Auto">
                    <TextBlock Text="GPU 加速" Classes="sectionTitle" />
                    <Button Grid.Column="1" Classes="windowButton" Width="30" Height="30" Padding="0"
                            Click="CudaRefresh_OnClick" ToolTip.Tip="重新检测 GPU 与 CUDA">
                      <icons:MaterialIcon Kind="Refresh" Width="17" Height="17" Foreground="#59636F" />
                    </Button>
                  </Grid>
                  <Border x:Name="CudaStatusCard" Classes="deploymentCard motion-item" Padding="18,16"
                          Background="#F4F6F8" BorderBrush="#D8DEE6" BorderThickness="1">
                    <Grid RowDefinitions="Auto,10,Auto,12,Auto" ColumnDefinitions="*">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon x:Name="CudaHeaderCheckIcon" Kind="CheckCircle" Width="18" Height="18"
                                                Foreground="#16A34A" VerticalAlignment="Center" IsVisible="False" />
                            <TextBlock x:Name="CudaStatusTitle" Text="正在检测 GPU 与 CUDA…" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock x:Name="CudaGpuInfoText" Text="读取 NVIDIA 显卡与驱动信息" Foreground="#667181" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                      <Border Grid.Row="2" BorderBrush="#DCE2E8" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <StackPanel Spacing="4">
                          <TextBlock x:Name="CudaStatusDetailText" Text="CUDA 运行库将安装在 AstraCat 私有目录" Foreground="#536071" FontSize="11" />
                          <TextBlock Text="仅包含推理所需运行库，不安装开发工具，也不修改系统环境变量" Foreground="#7D8794" FontSize="10.5" />
                        </StackPanel>
                      </Border>
                      <Grid Grid.Row="4" ColumnDefinitions="*,14,Auto">
                        <ComboBox x:Name="CudaVersionCombo" Classes="settingSelect" HorizontalAlignment="Stretch" MinWidth="250"
                                  SelectedIndex="0" SelectionChanged="CudaVersion_OnSelectionChanged">
                          <ComboBoxItem Content="CUDA 12.8（推荐 · 541 MiB）" Tag="12.8" />
                          <ComboBoxItem Content="CUDA 12.4（兼容 · 376 MiB）" Tag="12.4" />
                          <ComboBoxItem Content="仅 CPU（不下载）" Tag="cpu" />
                        </ComboBox>
                        <Button x:Name="CudaInstallAction" Grid.Column="2" Classes="primary cudaInstall" Height="36" MinWidth="190"
                                Padding="18,0" Click="CudaInstall_OnClick">
                          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <icons:MaterialIcon x:Name="CudaInstalledIcon" Kind="CheckCircle" Width="16" Height="16"
                                                Foreground="#FFFFFF" IsVisible="False" VerticalAlignment="Center" />
                            <TextBlock x:Name="CudaInstallActionText" Text="下载安装 CUDA 12.8" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Grid>
                  </Border>
                </StackPanel>

                <TextBlock x:Name="ModelDetailProgress" Grid.Row="4" Text="将自动补齐缺失的附属运行环境" Foreground="#7E8794" FontSize="11" HorizontalAlignment="Center" />
                <Button x:Name="ModelDetailPrimaryAction" Grid.Row="6" Classes="modelDetailPrimary" Click="ModelDetailPrimary_OnClick">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon x:Name="ModelDetailPrimaryIcon" Kind="DownloadOutline" Width="18" Height="18" VerticalAlignment="Center" />
                    <icons:MaterialIcon x:Name="ModelDetailManageIcon" Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center" IsVisible="False" />
                    <TextBlock x:Name="ModelDetailPrimaryText" Text="开始下载" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Grid.Row="8" Text="下载与模型管理共用这一套参数" Foreground="#A2A5AA" FontSize="10" HorizontalAlignment="Center" />
              </Grid>
              </Grid>

              <Grid x:Name="ModelSettingsView" IsVisible="False" Margin="0,22,0,0">
                <Border x:Name="ModelConfigurationEmpty" Classes="deploymentCard" Padding="28" IsVisible="False">
                  <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <PathIcon Data="{StaticResource AppIconDownloadStroked}" Width="28" Height="28" Foreground="#747982" />
                    <TextBlock Text="请先下载一个模型" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="模型下载完成后即可配置识别参数" Foreground="#89919D" FontSize="12" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>

                <Border x:Name="ModelConfigurationPanel" Classes="settingsPanel">
                  <Grid ColumnDefinitions="230,1,*">
                    <Border Background="#FAFAFB">
                      <Grid RowDefinitions="64,*,54">
                        <Border Padding="18,0" BorderBrush="#E8E9EC" BorderThickness="0,0,0,1">
                          <StackPanel VerticalAlignment="Center"><TextBlock Text="本地模型" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="选择需要配置的模型" Foreground="#8B8E96" FontSize="10.5" Margin="0,3,0,0" /></StackPanel>
                        </Border>
                        <Grid Grid.Row="1">
                          <ListBox x:Name="ConfiguredModelCombo" Classes="modelPicker" SelectionChanged="ConfiguredModel_OnSelectionChanged" />
                          <Border x:Name="ConfiguredModelIndicator" Width="3" Height="22" Margin="12,22,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="2"
                                  Background="#3399F3" IsVisible="False" IsHitTestVisible="False" />
                        </Grid>
                        <Border Grid.Row="2" Padding="18,0" BorderBrush="#E8E9EC" BorderThickness="0,1,0,0">
                          <TextBlock Text="仅显示已安装模型" Foreground="#92959D" FontSize="10" VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#E5E6E9" />
                    <StackPanel x:Name="ModelConfigurationContent" Grid.Column="2">
                      <Border Height="56" Padding="20,0" BorderBrush="#E8E9EC" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="ConfiguredModelTitle" Text="模型参数" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                      </Border>
                        <Border x:Name="DeviceSettingRow" Classes="settingRow" BorderThickness="0"><Grid ColumnDefinitions="*,150"><StackPanel VerticalAlignment="Center"><TextBlock Text="运行设备" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="优先使用可用的独立显卡" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="DeviceCombo" Grid.Column="1" Classes="settingSelect" SelectedIndex="0"><ComboBoxItem Content="自动选择" /><ComboBoxItem Content="CUDA 显卡" /><ComboBoxItem Content="CPU" /></ComboBox></Grid></Border>
                    <Border x:Name="LanguageSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,150"><StackPanel VerticalAlignment="Center"><TextBlock Text="识别语言" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="自动检测适合多语言或混合内容" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="LanguageCombo" Grid.Column="1" Classes="settingSelect" SelectedIndex="0"><ComboBoxItem Content="自动检测" Tag="" /></ComboBox></Grid></Border>
                        <Border x:Name="PrecisionSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,150"><StackPanel VerticalAlignment="Center"><TextBlock Text="计算精度" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="较低精度可以减少显存占用" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="PrecisionCombo" Grid.Column="1" Classes="settingSelect" SelectedIndex="0"><ComboBoxItem Content="自动" /><ComboBoxItem Content="Float16" /><ComboBoxItem Content="Int8" /></ComboBox></Grid></Border>
                        <Border x:Name="BeamSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,245"><StackPanel VerticalAlignment="Center"><TextBlock Text="搜索宽度（Beam Size）" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="数值越高越准确，但识别速度更慢" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><Grid Grid.Column="1" ColumnDefinitions="*,32"><Slider x:Name="BeamSizeSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="False" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding #BeamSizeSlider.Value, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" /></Grid></Grid></Border>
                        <Border x:Name="VadSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="静音过滤（VAD）" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="跳过长静音片段，减少空字幕" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><ToggleSwitch x:Name="VadToggle" Grid.Column="1" IsChecked="True" OnContent="" OffContent="" /></Grid></Border>
                    <Border x:Name="VadThresholdSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,245"><StackPanel VerticalAlignment="Center"><TextBlock Text="VAD 灵敏度阈值" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="数值越低越容易捕捉微弱语音，推荐 0.30" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><Grid Grid.Column="1" ColumnDefinitions="*,42"><Slider x:Name="VadThresholdSlider" Minimum="0.1" Maximum="0.9" Value="0.3" TickFrequency="0.05" IsSnapToTickEnabled="False" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding #VadThresholdSlider.Value, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" /></Grid></Grid></Border>
                        <Border x:Name="VadMinSilenceSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,245"><StackPanel VerticalAlignment="Center"><TextBlock Text="最短静音切分时长" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="连续静音超过该时长时自动划分为新句段，推荐 2000 ms" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><Grid Grid.Column="1" ColumnDefinitions="*,56"><Slider x:Name="VadMinSilenceSlider" Minimum="500" Maximum="5000" Value="2000" TickFrequency="100" IsSnapToTickEnabled="False" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding #VadMinSilenceSlider.Value, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" /></Grid></Grid></Border>
                        <Border x:Name="VadSpeechPadSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,245"><StackPanel VerticalAlignment="Center"><TextBlock Text="语音边缘缓冲填充" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="在每个语音段首尾额外保留的毫秒数，推荐 400 ms" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><Grid Grid.Column="1" ColumnDefinitions="*,56"><Slider x:Name="VadSpeechPadSlider" Minimum="0" Maximum="1000" Value="400" TickFrequency="50" IsSnapToTickEnabled="False" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding #VadSpeechPadSlider.Value, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" /></Grid></Grid></Border>
                        <Border x:Name="MaxTokensSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,245"><StackPanel VerticalAlignment="Center"><TextBlock Text="最大生成长度" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="用于 Qwen 等生成式语音模型" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><Grid Grid.Column="1" ColumnDefinitions="*,42"><Slider x:Name="MaxTokensSlider" Minimum="128" Maximum="1024" Value="512" TickFrequency="128" IsSnapToTickEnabled="False" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding #MaxTokensSlider.Value, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" /></Grid></Grid></Border>
                        <Border x:Name="TimestampSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="词级时间戳" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="为每个词输出精确起止时间" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><ToggleSwitch x:Name="TimestampToggle" Grid.Column="1" IsChecked="True" OnContent="" OffContent="" /></Grid></Border>
                        <Border x:Name="HotwordsSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,220"><StackPanel VerticalAlignment="Center"><TextBlock Text="热词" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="用逗号分隔人名、品牌名和专业词汇" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><TextBox x:Name="HotwordsBox" Grid.Column="1" Classes="settingInput" PlaceholderText="例如：AstraCat, Qwen" /></Grid></Border>
                        <Border x:Name="EmotionSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="情绪识别" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="输出开心、悲伤、愤怒等情绪标签" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><ToggleSwitch x:Name="EmotionToggle" Grid.Column="1" IsChecked="True" OnContent="" OffContent="" /></Grid></Border>
                        <Border x:Name="AudioEventSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="声音事件识别" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="识别音乐、掌声、笑声等非语音事件" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><ToggleSwitch x:Name="AudioEventToggle" Grid.Column="1" IsChecked="True" OnContent="" OffContent="" /></Grid></Border>
                        <Border x:Name="SpeakerCountSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,150"><StackPanel VerticalAlignment="Center"><TextBlock Text="说话人数" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="限制说话人分离的目标人数" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="SpeakerCountCombo" Grid.Column="1" Classes="settingSelect" SelectedIndex="0"><ComboBoxItem Content="自动检测" /><ComboBoxItem Content="2 人" /><ComboBoxItem Content="3 人" /><ComboBoxItem Content="4 人" /><ComboBoxItem Content="5 人以上" /></ComboBox></Grid></Border>
                        <Border x:Name="DiarizationSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="说话人分离" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="为不同说话人分配独立字幕轨道" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><ToggleSwitch x:Name="DiarizationToggle" Grid.Column="1" IsChecked="True" OnContent="" OffContent="" /></Grid></Border>
                        <Border x:Name="TemperatureSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,245"><StackPanel VerticalAlignment="Center"><TextBlock Text="采样温度" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="数值越低，生成结果越稳定" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><Grid Grid.Column="1" ColumnDefinitions="*,42"><Slider x:Name="TemperatureSlider" Minimum="0" Maximum="1" Value="0.2" TickFrequency="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding #TemperatureSlider.Value, StringFormat={}{0:0.0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" /></Grid></Grid></Border>
                        <Border x:Name="ChunkSecondsSettingRow" Classes="settingRow"><Grid ColumnDefinitions="*,245"><StackPanel VerticalAlignment="Center"><TextBlock Text="音频分块时长" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Text="长音频切分长度，较长可保留更多上下文" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><Grid Grid.Column="1" ColumnDefinitions="*,42"><Slider x:Name="ChunkSecondsSlider" Minimum="10" Maximum="60" Value="30" TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding #ChunkSecondsSlider.Value, StringFormat={}{0:0}s}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#3399F3" FontSize="11" /></Grid></Grid></Border>
                        <StackPanel x:Name="ModelAdvancedParameters" />
                        <Border Classes="settingRow"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="卸载该模型" FontWeight="Bold" FontSize="12.5" /><TextBlock Text="删除本地模型权重，保留当前模型的独立参数配置" Foreground="#858992" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><Button x:Name="ConfiguredModelUninstallAction" Grid.Column="1" Classes="componentUninstallAction" Click="ConfiguredModelUninstall_OnClick"><TextBlock Text="卸载该模型" Foreground="#FFFFFF" FontWeight="Bold" /></Button></Grid></Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>
            </ScrollViewer>

            <Border x:Name="ModelCatalogLoadingOverlay" ZIndex="20" IsVisible="False" IsHitTestVisible="True"
                    Background="#F7F7F8" Opacity="0">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Grid Width="26" Height="26" HorizontalAlignment="Center"
                      RowDefinitions="11,4,11" ColumnDefinitions="11,4,11">
                  <Border x:Name="ModelCatalogLoadingTileTopLeft" Grid.Row="0" Grid.Column="0"
                          Background="#747982" CornerRadius="4,1.5,1.5,1.5" />
                  <Border x:Name="ModelCatalogLoadingTileTopRight" Grid.Row="0" Grid.Column="2"
                          Background="#747982" CornerRadius="1.5,4,1.5,1.5" />
                  <Border x:Name="ModelCatalogLoadingTileBottomLeft" Grid.Row="2" Grid.Column="0"
                          Background="#747982" CornerRadius="1.5,1.5,1.5,4" />
                  <Border x:Name="ModelCatalogLoadingTileBottomRight" Grid.Row="2" Grid.Column="2"
                          Background="#747982" CornerRadius="1.5,1.5,4,1.5" />
                </Grid>
                <TextBlock x:Name="ModelCatalogLoadingText" Text="正在获取模型列表…"
                           FontSize="12" FontWeight="SemiBold" Foreground="#5F6875"
                           HorizontalAlignment="Center" />
                <TextBlock Text="正在筛选可信发布者与兼容模型" FontSize="10.5" Foreground="#A0A6AF"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Settings page. -->
            <Grid x:Name="SettingsPage" IsVisible="False" Background="#F7F7F8" ColumnDefinitions="210,1,*">
              <!-- Category navigation. -->
              <Border Grid.Column="0" Background="#FBFBFB" Padding="14,24,12,24">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Spacing="4">
                    <TextBlock Text="设置" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="8,0,0,16" />

                    <!-- Group: 全部 -->
                    <Button x:Name="SettingsCatAll" Classes="settingsCatNav selected" Tag="all" Click="SettingsCategory_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:MaterialIcon Kind="TuneVariant" Width="17" Height="17" Foreground="#4B5563" />
                        <TextBlock Text="全部设置" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>

                    <!-- Group: 系统与存储 -->
                    <TextBlock Text="系统与存储" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="10,14,0,4" />
                    <Button x:Name="SettingsCatSystem" Classes="settingsCatNav" Tag="system" Click="SettingsCategory_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:MaterialIcon Kind="CogOutline" Width="17" Height="17" Foreground="#4B5563" />
                        <TextBlock Text="系统设置" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="SettingsCatStorage" Classes="settingsCatNav" Tag="storage" Click="SettingsCategory_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:MaterialIcon Kind="FolderOutline" Width="17" Height="17" Foreground="#4B5563" />
                        <TextBlock Text="存储与数据" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>

                    <!-- Group: 维护与支持 -->
                    <TextBlock Text="维护与支持" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="10,14,0,4" />
                    <Button x:Name="SettingsCatBackup" Classes="settingsCatNav" Tag="backup" Click="SettingsCategory_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:MaterialIcon Kind="PackageVariantClosed" Width="17" Height="17" Foreground="#4B5563" />
                        <TextBlock Text="备份与恢复" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="SettingsCatAbout" Classes="settingsCatNav" Tag="about" Click="SettingsCategory_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:MaterialIcon Kind="InformationOutline" Width="17" Height="17" Foreground="#4B5563" />
                        <TextBlock Text="关于 AstraCat" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Divider -->
              <Border Grid.Column="1" Width="1" Background="#EBECEF" />

              <!-- Settings content. -->
              <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <!-- Notice / Feedback Toast Banner -->
                <Border x:Name="SettingsNoticeBanner" Grid.Row="0" Margin="32,16,32,0" Padding="14,10"
                        CornerRadius="10" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1"
                        IsVisible="False">
                  <Grid ColumnDefinitions="Auto,*">
                    <icons:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="#16A34A" VerticalAlignment="Center" />
                    <TextBlock x:Name="SettingsNoticeText" Grid.Column="1" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="#16A34A" VerticalAlignment="Center" Text="设置已保存" />
                  </Grid>
                </Border>

                <ScrollViewer x:Name="SettingsCardsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="32,24,32,40" MaxWidth="880" HorizontalAlignment="Stretch" Spacing="18">

                    <!-- Page Header -->
                    <StackPanel Margin="0,0,0,6">
                      <TextBlock Text="设置" Classes="pageTitle" />
                      <TextBlock Text="通用偏好、存储目录与备份恢复" Classes="muted" FontSize="13" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- 系统设置 -->
                    <Border x:Name="SettingsCardSystem" Classes="settingsModernCard">
                      <StackPanel Spacing="14">
                        <!-- Card Header -->
                        <Grid ColumnDefinitions="Auto,*">
                          <Border Classes="settingIconBadge">
                            <icons:MaterialIcon Kind="Cog" Width="18" Height="18" Foreground="#374151" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="系统设置" FontSize="15" FontWeight="Bold" Foreground="#111827" />
                            <TextBlock Text="语言偏好、模型下载镜像与硬件计算模式" FontSize="11.5" Foreground="#6B7280" Margin="0,2,0,0" />
                          </StackPanel>
                        </Grid>

                        <!-- Row 1: 切换语言 -->
                        <Border Classes="settingModernRow">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="切换语言" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                              <TextBlock Text="设置应用程序界面显示语言" FontSize="11.5" Foreground="#6B7280" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="SettingsLanguageCombo" Grid.Column="1" Classes="settingSelect" Width="140"
                                      SelectionChanged="SettingsValue_OnSelectionChanged">
                              <ComboBoxItem Content="简体中文" />
                            </ComboBox>
                          </Grid>
                        </Border>

                        <!-- Row 2: 模型下载源 -->
                        <Border Classes="settingModernRow">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="模型下载镜像源" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                                <icons:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14" Foreground="#9CA3AF"
                                                    ToolTip.Tip="国内网络环境下推荐使用 HF-Mirror 镜像加速模型下载" />
                              </StackPanel>
                              <TextBlock Text="下载语音识别和语言模型权重时使用的高速节点" FontSize="11.5" Foreground="#6B7280" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="SettingsDownloadSourceCombo" Grid.Column="1" Classes="settingSelect" Width="170"
                                      SelectionChanged="SettingsValue_OnSelectionChanged">
                              <ComboBoxItem Content="自动选择 (推荐)" />
                              <ComboBoxItem Content="HF-Mirror 镜像" />
                              <ComboBoxItem Content="Hugging Face 官方" />
                            </ComboBox>
                          </Grid>
                        </Border>

                        <!-- Row 3: GPU 加速管理卡片 (沿用下载页面的 GPU 加速卡片) -->
                        <StackPanel Spacing="6" Margin="0,4,0,4">
                          <Grid Margin="2,0,0,0" ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="GPU 加速" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                              <icons:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14" Foreground="#9CA3AF"
                                                  ToolTip.Tip="检测本地 GPU 并管理私有 CUDA 运行库" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="windowButton" Width="28" Height="28" Padding="0"
                                    Click="SettingsCudaRefresh_OnClick" ToolTip.Tip="重新检测 GPU 与 CUDA">
                              <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" Foreground="#59636F" />
                            </Button>
                          </Grid>
                          <Border x:Name="SettingsCudaStatusCard" Padding="16,14"
                                  Background="#F4F6F8" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="10">
                            <Grid RowDefinitions="Auto,10,Auto,12,Auto" ColumnDefinitions="*">
                              <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <icons:MaterialIcon x:Name="SettingsCudaHeaderCheckIcon" Kind="CheckCircle" Width="18" Height="18"
                                                      Foreground="#16A34A" VerticalAlignment="Center" IsVisible="False" />
                                  <TextBlock x:Name="SettingsCudaStatusTitle" Text="正在检测 GPU 与 CUDA…" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="SettingsCudaGpuInfoText" Text="读取 NVIDIA 显卡与驱动信息" Foreground="#667181" FontSize="11" Margin="0,3,0,0" />
                              </StackPanel>
                              <Border Grid.Row="2" BorderBrush="#DCE2E8" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <StackPanel Spacing="4">
                                  <TextBlock x:Name="SettingsCudaStatusDetailText" Text="CUDA 运行库将安装在 AstraCat 私有目录" Foreground="#536071" FontSize="11" />
                                  <TextBlock Text="仅包含推理所需运行库，不安装开发工具，也不修改系统环境变量" Foreground="#7D8794" FontSize="10.5" />
                                </StackPanel>
                              </Border>
                              <Grid Grid.Row="4" ColumnDefinitions="*,12,Auto">
                                <ComboBox x:Name="SettingsCudaVersionCombo" Classes="settingSelect" HorizontalAlignment="Stretch" MinWidth="220"
                                          SelectedIndex="0" SelectionChanged="SettingsCudaVersion_OnSelectionChanged">
                                  <ComboBoxItem Content="CUDA 12.8（推荐 · 541 MiB）" Tag="12.8" />
                                  <ComboBoxItem Content="CUDA 12.4（兼容 · 376 MiB）" Tag="12.4" />
                                  <ComboBoxItem Content="仅 CPU（不下载）" Tag="cpu" />
                                </ComboBox>
                                <Button x:Name="SettingsCudaInstallAction" Grid.Column="2" Classes="primary cudaInstall" Height="36" MinWidth="175"
                                        Padding="16,0" Click="SettingsCudaInstall_OnClick">
                                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <icons:MaterialIcon x:Name="SettingsCudaInstalledIcon" Kind="CheckCircle" Width="16" Height="16"
                                                        Foreground="#FFFFFF" IsVisible="False" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SettingsCudaInstallActionText" Text="下载安装 CUDA 12.8" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Button>
                              </Grid>
                            </Grid>
                          </Border>
                        </StackPanel>

                        <!-- Row 4: 启动时检查更新 -->
                        <Border Classes="settingModernRow">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="启动时检查更新" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                                <icons:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14" Foreground="#9CA3AF"
                                                    ToolTip.Tip="每次启动应用时自动静默检查是否有新版本" />
                              </StackPanel>
                            </StackPanel>
                            <ToggleSwitch x:Name="SettingsCheckUpdatesToggle" Grid.Column="1" IsChecked="True"
                                          OnContent="" OffContent="" PropertyChanged="SettingsToggle_OnPropertyChanged" />
                          </Grid>
                        </Border>

                        <!-- Row 5: 执行任务时阻止系统休眠 -->
                        <Border Classes="settingModernRow">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="有执行任务时阻止系统休眠" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                                <icons:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14" Foreground="#9CA3AF"
                                                    ToolTip.Tip="在语音转写、AI 翻译与视频压制期间防止 Windows 进入睡眠中断任务" />
                              </StackPanel>
                            </StackPanel>
                            <ToggleSwitch x:Name="SettingsPreventSleepToggle" Grid.Column="1" IsChecked="True"
                                          OnContent="" OffContent="" PropertyChanged="SettingsToggle_OnPropertyChanged" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>

                    <!-- 存储位置与缓存 -->
                    <Border x:Name="SettingsCardStorage" Classes="settingsModernCard">
                      <StackPanel Spacing="14">
                        <!-- Card Header -->
                        <Grid ColumnDefinitions="Auto,*">
                          <Border Classes="settingIconBadge">
                            <icons:MaterialIcon Kind="FolderOutline" Width="18" Height="18" Foreground="#374151" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="存储位置" FontSize="15" FontWeight="Bold" Foreground="#111827" />
                            <TextBlock Text="统一管理模型、引擎运行时、项目数据与临时波形缓存的存放位置" FontSize="11.5" Foreground="#6B7280" Margin="0,2,0,0" />
                          </StackPanel>
                        </Grid>

                        <!-- Row 1: 统一存储目录 -->
                        <Border Classes="settingModernRow">
                          <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="统一存储目录" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                              <icons:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14" Foreground="#9CA3AF"
                                                  ToolTip.Tip="存放本地语音模型权重、Python 引擎环境与运行时的根目录" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,0">
                              <TextBox x:Name="SettingsRuntimePathBox" IsReadOnly="True" Classes="settingPathBox" Margin="0,0,8,0" />
                              <Button x:Name="SettingsBrowseRuntimeButton" Grid.Column="1" Classes="actionPrimarySmall" Margin="0,0,6,0"
                                      Click="SettingsBrowseRuntimeRoot_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <icons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" Foreground="#FFFFFF" />
                                  <TextBlock Text="浏览" Foreground="#FFFFFF" FontWeight="Bold" />
                                </StackPanel>
                              </Button>
                              <Button x:Name="SettingsOpenRuntimeButton" Grid.Column="2" Classes="actionOutlineSmall"
                                      Click="SettingsOpenRuntimeRoot_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <icons:MaterialIcon Kind="OpenInNew" Width="15" Height="15" />
                                  <TextBlock Text="打开目录" />
                                </StackPanel>
                              </Button>
                            </Grid>
                            <TextBlock Text="仅改变模型、引擎运行时和临时文件的读写位置；旧文件不会自动迁移，如需迁移可手动移动或重新下载。"
                                       FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="2,2,0,0" />
                          </StackPanel>
                        </Border>

                        <!-- Row 2: 项目数据目录 -->
                        <Border Classes="settingModernRow">
                          <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="项目数据目录" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                              <icons:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14" Foreground="#9CA3AF"
                                                  ToolTip.Tip="存放字幕工程配置文件、分段草稿与时间轴数据的存储目录" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                              <TextBox x:Name="SettingsProjectPathBox" IsReadOnly="True" Classes="settingPathBox" Margin="0,0,8,0" />
                              <Button x:Name="SettingsOpenProjectButton" Grid.Column="1" Classes="actionOutlineSmall"
                                      Click="SettingsOpenProjectData_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <icons:MaterialIcon Kind="OpenInNew" Width="15" Height="15" />
                                  <TextBlock Text="打开目录" />
                                </StackPanel>
                              </Button>
                            </Grid>
                          </StackPanel>
                        </Border>

                        <!-- Row 3: 临时波形与缓存目录 -->
                        <Border Classes="settingModernRow">
                          <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="临时与波形缓存" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                              <icons:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14" Foreground="#9CA3AF"
                                                  ToolTip.Tip="存放音频波形预渲染数据与中间处理切片文件，可随时安全清除" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                              <TextBox x:Name="SettingsCachePathBox" IsReadOnly="True" Classes="settingPathBox" Margin="0,0,8,0" />
                              <Button x:Name="SettingsClearCacheButton" Grid.Column="1" Classes="actionPrimarySmall"
                                      Click="SettingsClearCache_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <icons:MaterialIcon Kind="Broom" Width="15" Height="15" Foreground="#FFFFFF" />
                                  <TextBlock x:Name="SettingsCacheSizeText" Text="清除缓存 (约 0 KB)" Foreground="#FFFFFF" FontWeight="Bold" />
                                </StackPanel>
                              </Button>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>

                    <!-- 配置导入导出 -->
                    <Border x:Name="SettingsCardBackup" Classes="settingsModernCard">
                      <StackPanel Spacing="14">
                        <!-- Card Header -->
                        <Grid ColumnDefinitions="Auto,*">
                          <Border Classes="settingIconBadge">
                            <icons:MaterialIcon Kind="PackageVariantClosed" Width="18" Height="18" Foreground="#374151" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="配置导入导出" FontSize="15" FontWeight="Bold" Foreground="#111827" />
                            <TextBlock Text="导出或导入应用配置（包括翻译服务商 API 配置、ASR 模型参数和系统设置）。" FontSize="11.5" Foreground="#6B7280" Margin="0,2,0,0" TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>

                        <Border Classes="settingModernRow">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="配置备份与迁移" FontSize="13" FontWeight="SemiBold" Foreground="#111827" />
                              <TextBlock Text="将本地所有配置打包为独立 JSON 文件保存或恢复" FontSize="11.5" Foreground="#6B7280" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                              <Button x:Name="SettingsExportButton" Classes="actionPrimarySmall" Click="SettingsExportConfig_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <icons:MaterialIcon Kind="Upload" Width="15" Height="15" Foreground="#FFFFFF" />
                                  <TextBlock Text="导出配置" Foreground="#FFFFFF" FontWeight="Bold" />
                                </StackPanel>
                              </Button>
                              <Button x:Name="SettingsImportButton" Classes="actionOutlineSmall" Click="SettingsImportConfig_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <icons:MaterialIcon Kind="Download" Width="15" Height="15" />
                                  <TextBlock Text="导入配置" />
                                </StackPanel>
                              </Button>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>

                    <!-- 关于 -->
                    <Border x:Name="SettingsCardAbout" Classes="settingsModernCard">
                      <StackPanel Spacing="14">
                        <!-- Card Header -->
                        <Grid ColumnDefinitions="Auto,*">
                          <Border Classes="settingIconBadge">
                            <icons:MaterialIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#374151" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="关于" FontSize="15" FontWeight="Bold" Foreground="#111827" />
                            <TextBlock Text="软件版本、开发信息与更新支持" FontSize="11.5" Foreground="#6B7280" Margin="0,2,0,0" />
                          </StackPanel>
                        </Grid>

                        <!-- Row 1: App Info -->
                        <Border Classes="settingModernRow">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="AstraCat · 小猫做字幕" FontSize="14" FontWeight="Bold" Foreground="#111827" />
                              <TextBlock Text="v1.0.0 · 高性能本地 AI 语音识别与字幕制作工具" FontSize="11.5" Foreground="#6B7280" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button x:Name="SettingsCheckUpdateButton" Grid.Column="1" Classes="actionOutlineSmall" Click="SettingsCheckUpdate_OnClick">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="Refresh" Width="15" Height="15" />
                                <TextBlock Text="检查更新" />
                              </StackPanel>
                            </Button>
                          </Grid>
                        </Border>

                        <!-- Row 2: Links -->
                        <Border Classes="settingModernRow">
                          <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button Classes="actionLink" Click="SettingsOpenGithub_OnClick">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="Github" Width="16" Height="16" Foreground="#4B5563" />
                                <TextBlock Text="GitHub 仓库" />
                              </StackPanel>
                            </Button>
                            <Button Classes="actionLink" Click="SettingsOpenFeedback_OnClick">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="CommentAlertOutline" Width="16" Height="16" Foreground="#4B5563" />
                                <TextBlock Text="反馈问题" />
                              </StackPanel>
                            </Button>
                            <Button Classes="actionLink" Click="SettingsOpenLogRoot_OnClick">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16" Foreground="#4B5563" />
                                <TextBlock Text="查看日志" />
                              </StackPanel>
                            </Button>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>

                    <!-- 危险操作 -->
                    <Border x:Name="SettingsCardDanger" Classes="dangerModernCard">
                      <StackPanel Spacing="12">
                        <!-- Header -->
                        <Grid ColumnDefinitions="Auto,*">
                          <Border Classes="dangerIconBadge">
                            <icons:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="#DC2626" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="危险操作" FontSize="15" FontWeight="Bold" Foreground="#DC2626" />
                            <TextBlock Text="恢复所有系统配置至初始状态" FontSize="11.5" Foreground="#991B1B" Margin="0,2,0,0" />
                          </StackPanel>
                        </Grid>

                        <!-- Action Row -->
                        <Border Padding="0,6,0,0">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                              <TextBlock Text="恢复默认设置" FontSize="13" FontWeight="Bold" Foreground="#111827" />
                              <TextBlock Text="将所有设置恢复为默认值，包括翻译设置、ASR 参数和系统配置。此操作不可撤销。"
                                         FontSize="11.5" Foreground="#6B7280" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="SettingsResetDefaultsButton" Grid.Column="1" Classes="actionDangerSmall"
                                    Click="SettingsResetDefaults_OnClick">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <icons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="#FFFFFF" />
                                <TextBlock Text="恢复默认" Foreground="#FFFFFF" FontWeight="Bold" />
                              </StackPanel>
                            </Button>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>

                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>

          <!-- Shared side panel kept at the content root so it can open above every primary page. -->
          <Grid x:Name="TranslationApiDrawerLayer" ZIndex="80" IsVisible="False" IsHitTestVisible="False">
            <Border x:Name="TranslationApiDrawerBackdrop" Background="#80000000" Opacity="0"
                    PointerPressed="TranslationApiDrawerBackdrop_OnPointerPressed" />
            <Border x:Name="TranslationApiDrawerPanel" Width="400" Margin="0,12,12,12"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Background="#FFFFFF" CornerRadius="24" ClipToBounds="True"
                    BoxShadow="0 14 42 0 #50000000" RenderTransformOrigin="50%,50%"
                    Focusable="True" KeyDown="TranslationApiDrawer_OnKeyDown">
              <Border.RenderTransform><TranslateTransform X="412" /></Border.RenderTransform>
              <Grid RowDefinitions="Auto,*">
                <Grid Margin="24,16,16,10" ColumnDefinitions="*,Auto">
                  <TextBlock Text="API 设置" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="noButtonMotion" Width="32" Height="32" Padding="0"
                          Background="Transparent" CornerRadius="8" Click="TranslationApiDrawerClose_OnClick"
                          ToolTip.Tip="关闭">
                    <icons:MaterialIcon Kind="Close" Width="17" Height="17" Foreground="#5F6368" />
                  </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="24,8,24,24" Spacing="22">
                    <Grid x:Name="TranslationDeveloperRoleRow" ColumnDefinitions="*,Auto" MinHeight="48">
                      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="使用 Developer 角色" FontSize="14" VerticalAlignment="Center" />
                        <icons:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Foreground="#858A92"
                                            ToolTip.Tip="将系统提示词作为 developer 角色发送（服务支持时）" />
                      </StackPanel>
                      <ToggleSwitch x:Name="TranslationDeveloperRoleToggle" Grid.Column="1"
                                    OnContent="" OffContent="" VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="TranslationStreamOptionsRow" ColumnDefinitions="*,Auto" MinHeight="48">
                      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="Stream Options" FontSize="14" VerticalAlignment="Center" />
                        <icons:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Foreground="#858A92"
                                            ToolTip.Tip="兼容 OpenAI Chat Completions 的流式选项" />
                      </StackPanel>
                      <ToggleSwitch x:Name="TranslationStreamOptionsToggle" Grid.Column="1" IsChecked="True"
                                    OnContent="" OffContent="" VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="TranslationReasoningSummaryRow" ColumnDefinitions="*,Auto" MinHeight="48">
                      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="推理摘要" FontSize="14" VerticalAlignment="Center" />
                        <icons:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Foreground="#858A92"
                                            ToolTip.Tip="允许 Responses 接口返回推理摘要" />
                      </StackPanel>
                      <ToggleSwitch x:Name="TranslationReasoningSummaryToggle" Grid.Column="1"
                                    OnContent="" OffContent="" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="#F0F0F0" />
                    <Grid ColumnDefinitions="*,Auto" MinHeight="48">
                      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="缓存 Token 阈值" FontSize="14" VerticalAlignment="Center" />
                        <icons:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Foreground="#858A92"
                                            ToolTip.Tip="消息超过此 Token 数才启用提示词缓存；0 表示关闭" />
                      </StackPanel>
                      <TextBox x:Name="TranslationCacheTokenThresholdBox" Grid.Column="1"
                               Classes="translationDrawerNumber" Text="1024" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="48">
                      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="缓存最后 N 条消息" FontSize="14" VerticalAlignment="Center" />
                        <icons:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Foreground="#858A92"
                                            ToolTip.Tip="缓存最后的 N 条对话消息，不包含系统消息" />
                      </StackPanel>
                      <TextBox x:Name="TranslationCacheLastNBox" Grid.Column="1"
                               Classes="translationDrawerNumber" Text="2" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="48">
                      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="缓存系统消息" FontSize="14" VerticalAlignment="Center" />
                        <icons:MaterialIcon Kind="InformationOutline" Width="15" Height="15" Foreground="#858A92"
                                            ToolTip.Tip="是否缓存系统提示词" />
                      </StackPanel>
                      <ToggleSwitch x:Name="TranslationCacheSystemToggle" Grid.Column="1"
                                    IsChecked="True" OnContent="" OffContent="" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Bottom-right task entry whose translucent fill reflects combined deployment progress. -->
    <Grid Grid.RowSpan="2" Panel.ZIndex="200" HorizontalAlignment="Right" VerticalAlignment="Bottom"
          Margin="0,0,15,15" IsHitTestVisible="True">
      <Border x:Name="DownloadTaskPanel" Width="390" Margin="0,0,0,60"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="#FCFFFFFF" BorderBrush="#E5E8ED" BorderThickness="1"
              CornerRadius="10" Padding="16,14" BoxShadow="0 7 24 0 #260D1B2A"
              IsVisible="False" Opacity="0" RenderTransformOrigin="100%,100%">
        <Border.RenderTransform>
          <TranslateTransform Y="8" />
        </Border.RenderTransform>
        <Grid RowDefinitions="Auto,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="下载任务" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock x:Name="DownloadTaskCountText" Grid.Column="1" Text="1 个任务"
                       FontSize="10.5" Foreground="#8B8F98" VerticalAlignment="Center" />
          </Grid>
          <ScrollViewer Grid.Row="1" MaxHeight="430" Margin="0,12,0,0"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DownloadTaskList" Spacing="9" />
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid x:Name="DownloadTaskButtonHost" Width="50" Height="50"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="False">
        <Border x:Name="DownloadTaskRipple" Width="40" Height="40" CornerRadius="20"
                Background="#6C65B9F5" HorizontalAlignment="Center" VerticalAlignment="Center"
                Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="50%,50%">
          <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Border.RenderTransform>
        </Border>
        <Button x:Name="DownloadTaskButton" Width="40" Height="40" Padding="0"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0" CornerRadius="20"
                ToolTip.Tip="任务管理" Click="DownloadTaskButton_OnClick"
                RenderTransformOrigin="50%,50%">
          <Button.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0" /></Button.RenderTransform>
          <Border Width="40" Height="40" CornerRadius="20" Background="#3399F3"
                  ClipToBounds="True" BoxShadow="0 3 10 0 #453399F3">
            <Grid>
              <Border x:Name="DownloadTaskProgressFill" Height="0" VerticalAlignment="Bottom"
                      Background="#35FFFFFF" IsHitTestVisible="False" />
              <icons:MaterialIcon Kind="Download" Width="20" Height="20" Foreground="#FFFFFF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsHitTestVisible="False" />
            </Grid>
          </Border>
        </Button>
      </Grid>
    </Grid>
  </Grid>
  </Border>
</Window>
