    <StreamGeometry x:Key="AppIconLightningStroked">M10.1 10.58c.06 0 .1.05.1.12l-1.1 6.36 7.02-7.11h-3.07a.1.1 0 0 1-.1-.15l3.5-6.8H9.71l-3.5 7.58h3.88ZM8.3 1.29A.5.5 0 0 1 8.76 1H18.9c.37 0 .61.4.44.73l-3.18 6.22h3.55a.5.5 0 0 1 .36.85L7.18 21.87a.5.5 0 0 1-.85-.44l1.51-8.85H3.88a.5.5 0 0 1-.46-.71L8.3 1.29Z</StreamGeometry>
    <StreamGeometry x:Key="AppIconSaveStroked">M2 4c0-1.1.9-2 2-2h10.96a2 2 0 0 1 1.41.59l5.04 5.04a2 2 0 0 1 .59 1.4V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4Zm9 0H8v3h3V4ZM6 4v4a1 1 0 0 0 1 1h5a1 1 0 0 0 1-1V4h1.96L20 9.04V20h-2v-5a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v5H4V4h2Zm10 12v4H8v-4h8Z</StreamGeometry>
    <StreamGeometry x:Key="AppIconTick">M21.35 4.27c.68.47.86 1.4.38 2.08l-10 14.5a1.5 1.5 0 0 1-2.33.17l-6.5-7a1.5 1.5 0 0 1 2.2-2.04l5.23 5.63 8.94-12.96a1.5 1.5 0 0 1 2.08-.38Z</StreamGeometry>
    <ControlTheme x:Key="AstraModelListItemTheme" TargetType="ListBoxItem">
      <Setter Property="Height" Value="46" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="ModelItemBackground" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
            <Grid ColumnDefinitions="3,*,18" Margin="4,0,10,0">
              <Border Width="3" Height="22" Opacity="0" />
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                Margin="12,0,0,0" VerticalContentAlignment="Center" FontSize="12" FontWeight="Bold" />
              <PathIcon Grid.Column="2" Data="{StaticResource AppIconTick}" Width="12" Height="12" Foreground="#676B73"
                        IsVisible="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#ModelItemBackground">
        <Setter Property="Background" Value="#F5F5F6" />
      </Style>
      <Style Selector="^:selected /template/ Border#ModelItemBackground">
        <Setter Property="Background" Value="#F1F1F3" />
      </Style>
      <Style Selector="^:selected:pointerover /template/ Border#ModelItemBackground">
        <Setter Property="Background" Value="#ECECEF" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="AstraSubtitleListItemTheme" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="ItemBorder" CornerRadius="8" Margin="0" Padding="0"
                  Background="Transparent" BorderThickness="0">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Margin="0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#ItemBorder">
        <Setter Property="Background" Value="#F8FAFC" />
      </Style>
      <Style Selector="^:selected /template/ Border#ItemBorder">
        <Setter Property="Background" Value="#F6F9FC" />
      </Style>
      <Style Selector="^:selected:pointerover /template/ Border#ItemBorder">
        <Setter Property="Background" Value="#EFF7FE" />
      </Style>
    </ControlTheme>
    <!-- Separate track themes preserve measurement while the thumb provides a larger hit area. -->
    <ControlTheme x:Key="AstraSliderTrackTheme" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <ControlTemplate TargetType="RepeatButton">
          <Grid Height="32" Background="Transparent">
            <Border Height="7" Margin="{TemplateBinding Margin}" VerticalAlignment="Center"
                    Background="{TemplateBinding Background}" CornerRadius="4" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="AstraSliderThumbTheme" TargetType="Thumb">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate TargetType="Thumb">
          <Grid Width="32" Height="32" Background="Transparent">
            <Border x:Name="AstraThumbVisual" Width="18" Height="18" CornerRadius="9"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#3399F3" BorderThickness="4"
                    BoxShadow="0 0 4 0 #66999999">
              <Border.Transitions>
                <Transitions>
                  <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
                  <ThicknessTransition Property="BorderThickness" Duration="0:0:0.12" />
                </Transitions>
              </Border.Transitions>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#AstraThumbVisual">
        <Setter Property="BoxShadow" Value="0 0 7 0 #77999999" />
      </Style>
      <Style Selector="^:pressed /template/ Border#AstraThumbVisual">
        <Setter Property="BoxShadow" Value="0 0 4 0 #66999999" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="AstraSliderTheme" TargetType="Slider">
      <Setter Property="Foreground" Value="#3399F3" />
      <Setter Property="Background" Value="#C9CDD2" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Template">
        <ControlTemplate TargetType="Slider">
          <Grid Height="32" Margin="{TemplateBinding Padding}" Background="Transparent">
            <Track x:Name="PART_Track" Orientation="Horizontal"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseButton>
                <RepeatButton x:Name="PART_DecreaseButton" Margin="0,0,-14,0"
                              Background="{TemplateBinding Foreground}"
                              Theme="{StaticResource AstraSliderTrackTheme}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton x:Name="PART_IncreaseButton" Margin="-14,0,0,0"
                              Background="{TemplateBinding Background}"
                              Theme="{StaticResource AstraSliderTrackTheme}" />
              </Track.IncreaseButton>
              <Thumb x:Name="PART_Thumb" Theme="{StaticResource AstraSliderThumbTheme}" />
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.48" />
      </Style>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <!-- A single clipped surface prevents nested presenter borders from producing mismatched radii. -->
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border x:Name="ButtonSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.2" />
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
              </Border.Transitions>
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <Border x:Name="ButtonFocusRing" Margin="2" CornerRadius="{TemplateBinding CornerRadius}"
                    BorderBrush="#873399F3" BorderThickness="0" IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button:focus-visible /template/ Border#ButtonFocusRing">
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button:pointerover /template/ Border#ButtonSurface">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.1" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="Theme">
        <ControlTheme TargetType="ToggleSwitch">
          <Setter Property="Foreground" Value="#3399F3" />
          <Setter Property="Width" Value="36" />
          <Setter Property="Height" Value="20" />
          <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="PART_MovingKnobs" Width="36" Height="20" RenderTransformOrigin="50%,50%">
            <Border x:Name="CompactSwitchTrack" Width="36" Height="20" CornerRadius="10"
                    Background="#C8CBD0">
              <Border.Transitions>
                <Transitions><BrushTransition Property="Background" Duration="0:0:0.14" /></Transitions>
              </Border.Transitions>
            </Border>
            <Border x:Name="CompactSwitchKnob" Width="16" Height="16" CornerRadius="8"
                    Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="#FFFFFF" BoxShadow="0 1 3 0 #35000000">
              <Border.RenderTransform><TranslateTransform X="0" /></Border.RenderTransform>
              <Border.Transitions>
                <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" /></Transitions>
              </Border.Transitions>
            </Border>
          </Grid>
        </ControlTemplate>
          </Setter>
          <Style Selector="^:checked /template/ Border#CompactSwitchTrack">
            <Setter Property="Background" Value="#3399F3" />
          </Style>
          <Style Selector="^:checked /template/ Border#CompactSwitchKnob">
            <Setter Property="RenderTransform" Value="translate(16px, 0px)" />
          </Style>
        </ControlTheme>
      </Setter>
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#7A7D84" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#E8E8EA" />
      <Setter Property="Foreground" Value="#50535A" />
    </Style>
    <Style Selector="Button.nav:pressed">
      <Setter Property="Background" Value="#DEDEE1" />
      <Setter Property="Foreground" Value="#2A2C31" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#E5E8EC" />
      <Setter Property="Foreground" Value="#111216" />
    </Style>
    <Style Selector="Button.taskOverviewRow">
      <Setter Property="MinHeight" Value="78" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#20232A" />
      <Setter Property="BorderBrush" Value="#E3E6EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.taskOverviewRow:pointerover">
      <Setter Property="Background" Value="#F7FBFF" />
      <Setter Property="BorderBrush" Value="#9CCCF7" />
    </Style>
    <Style Selector="Button.taskOverviewRow:pressed">
      <Setter Property="Background" Value="#EEF6FD" />
    </Style>
    <Style Selector="ListBox#TaskOverviewListHost > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox#TaskOverviewListHost > ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#TaskOverviewListHost > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#TaskOverviewListHost > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#TaskOverviewListHost > ListBoxItem:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#TaskOverviewListHost > ListBoxItem:focus-visible /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#TaskOverviewListHost > ListBoxItem:selected:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="GridSplitter.workspaceSplitter">
      <Setter Property="Background" Value="#E5E8EC" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="GridSplitter.workspaceSplitter:pointerover">
      <Setter Property="Background" Value="#3399F3" />
    </Style>
    <Style Selector="Button.homeRecentRow">
      <Setter Property="Height" Value="68" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#20232A" />
      <Setter Property="BorderBrush" Value="#EAEBF0" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.homeRecentRow:pointerover">
      <Setter Property="Background" Value="#F6FAFE" />
      <Setter Property="BorderBrush" Value="#D7E8F8" />
    </Style>
    <Style Selector="Button.homeQuickStart">
      <Setter Property="MinHeight" Value="158" />
      <Setter Property="Padding" Value="18,20" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#FAFAFB" />
      <Setter Property="Foreground" Value="#20232A" />
      <Setter Property="BorderBrush" Value="#E1E2E5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.homeQuickStart:pointerover">
      <Setter Property="Background" Value="#F3F8FD" />
      <Setter Property="BorderBrush" Value="#9CCCF7" />
    </Style>
    <Style Selector="Border.navBadge">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.navBadgeText">
      <Setter Property="Foreground" Value="#777A82" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Padding" Value="17,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
