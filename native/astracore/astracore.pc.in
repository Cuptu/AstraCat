prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: AstraCore
Description: High-performance, lightweight media processing and subtitle engine built on FFmpeg 9.0.1
Version: @PROJECT_VERSION@
Requires: libavformat, libavcodec, libavutil, libswresample, libavfilter
Libs: -L${libdir} -lAstraCore.Native
Cflags: -I${includedir}
