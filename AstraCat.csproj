<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.1.2-DEV</Version>
    <RepositoryUrl>https://github.com/Cuptu/AstraCat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets\Brand\AstraCat.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**"
                      Exclude="Assets\Badges\**;Assets\Brand\AstraCat.svg;Assets\Brand\AstraCatLogo.svg;Assets\Brand\AstraCatLogo.png;Assets\Brand\AstraCatLogo-source.png;Assets\Models\qwen.jpg;Assets\Models\systran.png;Assets\Models\whisper.png" />
    <None Include="Assets\Fonts\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtime\tools\**" Exclude="runtime\tools\mpv\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtime\tools\mpv\libmpv-2.dll"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('runtime\tools\mpv\libmpv-2.dll')"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtime\tools\mpv\libmpv.so.2"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) and Exists('runtime\tools\mpv\libmpv.so.2')"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtime\tools\mpv\libmpv.2.dylib"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('runtime\tools\mpv\libmpv.2.dylib')"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtime\tools\mpv\libEGL.dll"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('runtime\tools\mpv\libEGL.dll')"
          Link="libEGL.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="native\libegl-avalonia-forwarder\libEGL.dll"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('native\libegl-avalonia-forwarder\libEGL.dll') and !Exists('runtime\tools\mpv\libEGL.dll')"
          Link="libEGL.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtime\tools\mpv\LIBMPV_SOURCE.md"
          Condition="Exists('runtime\tools\mpv\LIBMPV_SOURCE.md')"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AstraCat.Tests" />
  </ItemGroup>

  <!-- 独立基准项目与单元测试项目不能被桌面主项目递归编译。 -->
  <ItemGroup>
    <Compile Remove="tests\**;benchmarks\ui-load-comparison\**;artifacts\**;benchmarks\**\obj\**;benchmarks\**\bin\**" />
  </ItemGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_AOT</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <Compile Remove="benchmarks\**" />
  </ItemGroup>
</Project>
